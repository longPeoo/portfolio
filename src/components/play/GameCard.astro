---
/**
 * Thẻ một trò chơi ở trang /play: shadcn Card, bìa là "hộp quà giữa vũ trụ" (nền đêm, sao, dải ruy băng cam).
 * Rê chuột: ruy băng tuột sang hai bên, nơ bật lên, Orbi bay lên khỏi hộp, đèn LIVE sáng.
 */
import { ArrowUpRightIcon } from 'lucide-react';
import Orbi from '@/components/brand/Orbi.astro';
import { Badge } from '@/components/ui/badge';
import { buttonVariants } from '@/components/ui/button';
import { Card, CardContent, CardDescription, CardFooter, CardHeader, CardTitle } from '@/components/ui/card';
import { getI18n } from '@/lib/i18n';
import { cn } from '@/lib/utils';
import type { Game } from '@/lib/play/games';

interface Props {
  game: Game;
}

const { game } = Astro.props;
const { t, path } = getI18n(Astro.url);
const { title, description, players, season } = game.text(t);
const Icon = game.icon;
---

<a href={path(`/play/${game.slug}`)} class="gcard">
  <Card className="h-full gap-5 pt-0">
    <div class="gcard__cover" aria-hidden="true">
      <span class="gcard__stars"></span>
      <span class="gcard__ribbon gcard__ribbon--v"></span>
      <span class="gcard__ribbon gcard__ribbon--h"></span>
      <span class="gcard__bow"><i></i><i></i></span>
      <span class="gcard__orbi"><Orbi size={92} /></span>
      <span class="gcard__led mono"><i></i>{t.play.live}</span>
    </div>
    <CardHeader>
      <p class="mono muted">{game.code}{season && ` · ${season}`}</p>
      <CardTitle className="font-heading text-2xl leading-tight font-bold">{title}</CardTitle>
      <CardDescription className="text-base">{description}</CardDescription>
    </CardHeader>
    <CardContent className="mt-auto">
      <Badge variant="telemetry"><Icon data-icon="inline-start" />{t.play.players} · {players}</Badge>
    </CardContent>
    <CardFooter className="border-t pt-4 pb-4">
      <span class={cn(buttonVariants({ variant: 'launch', size: 'pill' }), 'gcard__cta')}>
        {t.play.play} <ArrowUpRightIcon data-icon="inline-end" />
      </span>
    </CardFooter>
  </Card>
</a>

<style>
  .gcard { display: block; height: 100%; text-decoration: none; transition: transform var(--dur) var(--ease-spring); }
  .gcard:hover { transform: translateY(-4px); }
  .gcard:focus-visible { outline: 2px dashed var(--ring); outline-offset: 4px; border-radius: var(--radius-xl); }

  .gcard__cover {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: radial-gradient(120% 90% at 50% 110%, var(--c-space-2), var(--c-space) 70%);
  }
  .gcard__stars {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(1.5px 1.5px at 12% 22%, var(--c-paper) 50%, transparent 52%),
      radial-gradient(1px 1px at 28% 70%, var(--c-paper) 50%, transparent 52%),
      radial-gradient(2px 2px at 82% 18%, var(--c-sun) 50%, transparent 52%),
      radial-gradient(1px 1px at 70% 80%, var(--c-paper) 50%, transparent 52%),
      radial-gradient(1.5px 1.5px at 90% 55%, var(--c-paper) 50%, transparent 52%),
      radial-gradient(1px 1px at 45% 12%, var(--c-paper) 50%, transparent 52%);
    opacity: 0.8;
    animation: gcard-twinkle 3.2s ease-in-out infinite alternate;
  }

  /* Ruy băng gói quà: dải dọc + dải ngang, tuột ra khi rê chuột */
  .gcard__ribbon { position: absolute; background: var(--primary); box-shadow: 0 0 0 1px rgb(0 0 0 / 0.15); transition: transform var(--dur-slow) var(--ease-spring); }
  .gcard__ribbon--v { top: 0; bottom: 0; left: 50%; width: 22px; translate: -50% 0; }
  .gcard__ribbon--h { left: 0; right: 0; top: 50%; height: 22px; translate: 0 -50%; }
  .gcard:hover .gcard__ribbon--v { transform: translateX(min(34vw, 180px)); }
  .gcard:hover .gcard__ribbon--h { transform: translateY(min(14vw, 90px)); }

  .gcard__bow { position: absolute; left: 50%; top: 50%; translate: -50% -50%; width: 74px; height: 40px; transition: transform var(--dur-slow) var(--ease-spring), opacity var(--dur); }
  .gcard__bow i {
    position: absolute;
    top: 0;
    width: 38px;
    height: 38px;
    border: 7px solid var(--c-sun);
    border-radius: 60% 40% 60% 40%;
  }
  .gcard__bow i:first-child { left: 0; transform: rotate(-30deg); }
  .gcard__bow i:last-child { right: 0; transform: rotate(30deg) scaleX(-1); }
  .gcard:hover .gcard__bow { transform: translateY(-120%) rotate(-12deg) scale(0.6); opacity: 0; }

  /* Orbi nấp sau nơ, bay lên khi mở quà */
  .gcard__orbi { position: absolute; left: 50%; top: 50%; translate: -50% -50%; transform: scale(0.4); opacity: 0; transition: transform var(--dur-slow) var(--ease-spring), opacity var(--dur); }
  .gcard:hover .gcard__orbi { transform: translateY(-6px) scale(1); opacity: 1; }

  .gcard__led {
    position: absolute;
    top: 14px;
    left: 14px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: var(--r-pill);
    background: rgb(11 16 38 / 0.72);
    color: var(--c-paper);
    font-size: 0.625rem;
    backdrop-filter: blur(6px);
  }
  .gcard__led i { width: 7px; height: 7px; border-radius: 50%; background: var(--c-aurora); box-shadow: 0 0 10px var(--c-aurora); animation: gcard-blink 1.4s steps(2) infinite; }

  .gcard__cta { pointer-events: none; }
  .gcard:hover :global(.gcard__cta) { translate: 0 -2px; box-shadow: 0 5px 0 0 var(--c-ink); }

  @keyframes gcard-twinkle { to { opacity: 0.35; } }
  @keyframes gcard-blink { 50% { opacity: 0.3; } }

  @media (prefers-reduced-motion: reduce) {
    .gcard__orbi { transform: none; opacity: 1; }
    .gcard__bow { opacity: 0; }
  }
</style>
