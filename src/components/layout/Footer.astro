---
import { site } from '@/lib/site';
import { buttonVariants } from '@/components/ui/button';
import { Separator } from '@/components/ui/separator';
import { cn } from '@/lib/utils';
import Orbi from '@/components/brand/Orbi.astro';

const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="container foot__grid">
    <div class="foot__signal">
      <p class="mono muted">MSN-99 · Send a signal</p>
      <a class="foot__mail" href={`mailto:${site.email}`}>{site.email}</a>
      {site.socials.length > 0 && (
        <ul class="foot__socials">
          {site.socials.map((s) => (
            <li>
              <a
                href={s.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={s.label}
                class={cn(buttonVariants({ variant: 'social', size: 'icon-lg' }))}
                set:html={s.iconSvg}
              />
            </li>
          ))}
        </ul>
      )}
    </div>

    <nav class="foot__nav" aria-label="Menu chân trang">
      <p class="mono muted">Điều hướng</p>
      <ul>
        {site.nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        <li><a href="/contact">Liên hệ</a></li>
      </ul>
    </nav>

    <div class="foot__moon" aria-hidden="true">
      <svg class="moon" viewBox="0 0 200 90">
        <path d="M10 90 Q100 -10 190 90 Z" />
        <circle cx="60" cy="62" r="7" class="crater" />
        <circle cx="128" cy="52" r="5" class="crater" />
        <circle cx="150" cy="74" r="4" class="crater" />
      </svg>
      <Orbi size={78} mood="sleep" class="foot__orbi" />
    </div>
  </div>

  <Separator />
  <div class="container foot__base mono">
    <span>© {year} {site.name} · Built on Earth, served from orbit</span>
    <button class={cn(buttonVariants({ variant: 'ghost', size: 'sm' }), 'foot__top')} type="button" data-to-top>
      <svg class="rocket" viewBox="0 0 24 32" width="18" height="24" aria-hidden="true">
        <path d="M12 1c5 4 7 10 6 17l-3 3H9l-3-3C5 11 7 5 12 1Z" fill="currentColor" />
        <circle cx="12" cy="11" r="2.6" fill="var(--bg)" />
        <path d="M6 18l-4 4 1 4 4-3M18 18l4 4-1 4-4-3" fill="var(--primary)" />
        <path class="flame" d="M10 22h4l-2 8Z" fill="var(--c-sun)" />
      </svg>
      Lên đầu trang
    </button>
  </div>
</footer>

<style>
  .foot {
    margin-top: var(--section-y);
    padding-top: var(--space-16);
    border-top: 1px solid var(--line);
    background: var(--bg-sunken);
    overflow: hidden;
  }
  .foot__grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    gap: var(--space-12);
    align-items: end;
  }
  .foot__mail {
    display: inline-block;
    margin-top: var(--space-3);
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 0.9rem + 1.9vw, 2.4rem);
    font-weight: 700;
    line-height: 1.1;
    text-decoration: none;
    background: linear-gradient(var(--primary), var(--primary)) 0 100% / 0 2px no-repeat;
    transition: background-size var(--dur-slow) var(--ease-out);
    overflow-wrap: break-word;
  }
  .foot__mail:hover { background-size: 100% 2px; }
  .foot__socials { display: flex; gap: 6px; list-style: none; padding: 0; margin-top: var(--space-6); }

  .foot__nav ul { list-style: none; padding: 0; margin-top: var(--space-3); display: grid; gap: 4px; }
  .foot__nav a { text-decoration: none; }
  .foot__nav a:hover { color: var(--primary); }

  .foot__moon { position: relative; justify-self: end; width: 200px; margin-bottom: -1px; }
  .moon path { fill: var(--c-paper-2); stroke: var(--line); }
  :global(.dark) .moon path { fill: #2a3058; }
  .moon .crater { fill: var(--fg); opacity: 0.08; }
  .foot__moon :global(.foot__orbi) { position: absolute; left: 62px; bottom: 58px; transform: rotate(-6deg); }

  .foot__base {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    padding-block: var(--space-6);
    color: var(--fg-muted);
    font-size: 0.6875rem;
  }
  .foot__top { gap: 8px; font-size: inherit; font-weight: inherit; text-transform: inherit; letter-spacing: inherit; }
  .foot__top:hover { color: var(--fg); }
  .rocket { width: 18px; height: 24px; transition: transform var(--dur) var(--ease-spring); }
  .foot__top:hover .rocket { transform: translateY(-3px); }
  .flame { transform-origin: 12px 22px; transform: scaleY(0); transition: transform var(--dur-fast); }
  .foot__top:hover .flame { transform: scaleY(1); animation: flicker 0.15s infinite alternate; }
  .foot__top[data-launch] .rocket { transform: translateY(-120px); transition: transform 700ms cubic-bezier(0.5, 0, 0.9, 0.3); }

  @keyframes flicker { to { transform: scaleY(0.7); } }

  @media (max-width: 760px) {
    .foot__grid { grid-template-columns: 1fr 1fr; }
    .foot__signal { grid-column: 1 / -1; }
    .foot__base { flex-direction: column-reverse; align-items: flex-start; }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const btn = document.querySelector<HTMLButtonElement>('[data-to-top]');
    btn?.addEventListener('click', () => {
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      btn.setAttribute('data-launch', '');
      window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
      window.setTimeout(() => btn.removeAttribute('data-launch'), 1200);
    });
  });
</script>
