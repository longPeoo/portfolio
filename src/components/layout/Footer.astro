---
import { site } from '@/lib/site';
import { t } from '@/lib/i18n';
import { buttonVariants } from '@/components/ui/button';
import { Separator } from '@/components/ui/separator';
import { cn } from '@/lib/utils';
import Orbi from '@/components/brand/Orbi.astro';
// Ảnh Mặt Trăng NASA dùng chung với hero (~11 KB), chỉ tải ở giao diện tối
import moonUrl from '@/assets/earth/moon.webp?url';

const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="container foot__grid">
    <div class="foot__signal">
      <p class="mono muted">{t.chrome.footerCode}</p>
      <a class="foot__mail" href={`mailto:${site.email}`}>{site.email}</a>
      {site.socials.length > 0 && (
        <ul class="foot__socials">
          {site.socials.map((s) => (
            <li>
              <a
                href={s.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={s.label}
                class={cn(buttonVariants({ variant: 'social', size: 'icon-lg' }))}
                set:html={s.iconSvg}
              />
            </li>
          ))}
        </ul>
      )}
    </div>

    <nav class="foot__nav" aria-label={t.chrome.footerNav}>
      <p class="mono muted">{t.chrome.footerNav}</p>
      <ul>
        {site.nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        <li><a href="/contact">{t.common.contact}</a></li>
      </ul>
    </nav>

    <!--
      Bầu trời nhỏ của Orbi. Sáng: Mặt Trời, Orbi bay cạnh sạc pin (hạt năng lượng bay vào tấm pin), rê chuột thì nhào lộn.
      Tối: Mặt Trăng thật tự quay, Orbi ngủ đung đưa trên đỉnh, sao lấp lánh, sao băng; rê chuột thì Orbi thức dậy nhảy lên.
    -->
    <div class="sky" aria-hidden="true" style={`--moon-map: url(${moonUrl})`}>
      <span class="sky__stars"></span>
      <span class="sky__meteor"></span>
      <span class="sun"><span class="sun__corona"></span><span class="sun__disc"><span class="sun__surface"></span></span></span>
      <span class="moon"><span class="moon__map"></span></span>
      <span class="sky__beam"><i></i><i></i><i></i></span>
      <span class="sky__orbi sky__orbi--sleep"><Orbi size={72} mood="sleep" /></span>
      <span class="sky__orbi sky__orbi--awake"><span class="sky__bob"><Orbi size={72} /></span></span>
    </div>
  </div>

  <Separator />
  <div class="container foot__base mono">
    <span>© {year} {site.name} · {t.chrome.footerTagline}</span>
    <button class={cn(buttonVariants({ variant: 'ghost', size: 'sm' }), 'foot__top')} type="button" data-to-top>
      <svg class="rocket" viewBox="0 0 24 32" width="18" height="24" aria-hidden="true">
        <path d="M12 1c5 4 7 10 6 17l-3 3H9l-3-3C5 11 7 5 12 1Z" fill="currentColor" />
        <circle cx="12" cy="11" r="2.6" fill="var(--bg)" />
        <path d="M6 18l-4 4 1 4 4-3M18 18l4 4-1 4-4-3" fill="var(--primary)" />
        <path class="flame" d="M10 22h4l-2 8Z" fill="var(--c-sun)" />
      </svg>
      {t.chrome.toTop}
    </button>
  </div>
</footer>

<style>
  .foot {
    margin-top: var(--section-y);
    border-top: 1px solid var(--line);
    background: var(--bg-sunken);
    overflow: hidden;
  }
  /* Ba khối căn giữa theo chiều dọc, cách đều vạch trên và vạch dưới */
  .foot__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    gap: var(--space-8) var(--space-16);
    align-items: center;
    padding-block: var(--space-12);
  }
  .foot__mail {
    display: inline-block;
    margin-top: var(--space-3);
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 0.9rem + 1.9vw, 2.4rem);
    font-weight: 700;
    line-height: 1.1;
    text-decoration: none;
    background: linear-gradient(var(--primary), var(--primary)) 0 100% / 0 2px no-repeat;
    transition: background-size var(--dur-slow) var(--ease-out);
    overflow-wrap: break-word;
  }
  .foot__mail:hover { background-size: 100% 2px; }
  .foot__socials { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; padding: 0; margin-top: var(--space-6); }

  /* Menu 3 cột × 2 dòng (điền theo cột) */
  .foot__nav ul {
    list-style: none;
    padding: 0;
    margin-top: var(--space-3);
    display: grid;
    grid-template-rows: repeat(2, auto);
    grid-auto-flow: column;
    grid-auto-columns: max-content;
    gap: 6px var(--space-8);
  }
  .foot__nav a { text-decoration: none; }
  .foot__nav a:hover { color: var(--primary); }

  /* ---------- Bầu trời của Orbi (khung 220 × 200) ---------- */
  .sky { position: relative; width: 220px; height: 200px; }
  .sky > * { position: absolute; }

  /* Mặt Trời: đĩa tối dần ở rìa, vết đen trôi theo vòng quay, nhật hoa xoay + phập phồng */
  .sun {
    left: 100px;
    top: 10px;
    width: 104px;
    height: 104px;
    transition: opacity var(--dur-slow) var(--ease-out), translate var(--dur-slow) var(--ease-out), scale var(--dur-slow) var(--ease-out);
  }
  .sun__corona {
    position: absolute;
    inset: -30px;
    border-radius: 50%;
    background: repeating-conic-gradient(color-mix(in oklab, var(--c-sun), transparent 30%) 0 4deg, transparent 4deg 15deg);
    mask: radial-gradient(closest-side, transparent 62%, #000 66%, transparent);
    animation: sky-spin 50s linear infinite, corona 5s ease-in-out infinite;
  }
  .sun__disc {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    overflow: hidden;
    background: radial-gradient(
      circle,
      color-mix(in oklab, var(--c-sun), white 60%) 0%,
      color-mix(in oklab, var(--c-sun), white 25%) 38%,
      var(--c-sun) 66%,
      color-mix(in oklab, var(--c-sun), var(--c-signal) 60%) 100%
    );
    box-shadow:
      0 0 0 1.5px color-mix(in oklab, var(--c-signal), transparent 55%),
      0 0 46px 8px color-mix(in oklab, var(--c-sun), transparent 45%);
    animation: sun-glow 5s ease-in-out infinite;
  }
  /* Dải bề mặt rộng gấp 4 lần, lặp 2 ô → trượt 50% là đúng một vòng, không giật */
  .sun__surface {
    position: absolute;
    inset: 0 auto 0 0;
    width: 400%;
    background:
      radial-gradient(circle at 18% 38%, color-mix(in oklab, var(--c-signal), var(--c-ink) 40%) 0 3px, color-mix(in oklab, var(--c-signal), transparent 40%) 4px, transparent 7px),
      radial-gradient(circle at 24% 46%, color-mix(in oklab, var(--c-signal), var(--c-ink) 40%) 0 2px, transparent 4px),
      radial-gradient(circle at 70% 64%, color-mix(in oklab, var(--c-signal), var(--c-ink) 30%) 0 2.5px, color-mix(in oklab, var(--c-signal), transparent 50%) 3.5px, transparent 6px),
      radial-gradient(ellipse 10% 18% at 44% 30%, color-mix(in oklab, var(--c-sun), white 55%), transparent),
      radial-gradient(ellipse 8% 14% at 88% 72%, color-mix(in oklab, var(--c-sun), white 50%), transparent);
    background-size: 50% 100%;
    opacity: 0.85;
    animation: sky-roll 40s linear infinite;
  }
  /* Rìa tối dần phủ lên vết đen để chúng mờ đi khi quay ra mép */
  .sun__disc::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: radial-gradient(circle, transparent 55%, color-mix(in oklab, var(--c-signal), transparent 55%) 100%);
  }

  /* Mặt Trăng: ảnh NASA tự quay, bóng tối phía dưới phải + quầng sáng nhẹ */
  .moon {
    left: 46px;
    top: 72px;
    width: 128px;
    height: 128px;
    border-radius: 50%;
    overflow: hidden;
    background: color-mix(in oklab, var(--c-paper), var(--c-space) 45%);
    box-shadow: 0 0 40px 2px color-mix(in oklab, var(--c-paper), transparent 82%);
    opacity: 0;
    translate: 0 28px;
    transition: opacity var(--dur-slow) var(--ease-out), translate var(--dur-slow) var(--ease-out);
  }
  .moon__map {
    position: absolute;
    inset: 0 auto 0 0;
    width: 400%;
    background-repeat: repeat-x;
    background-size: 50% 100%;
    filter: brightness(1.2) contrast(1.05);
    animation: sky-roll 90s linear infinite;
  }
  :global(.dark) .moon__map { background-image: var(--moon-map); }
  .moon::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: radial-gradient(
      circle at 34% 30%,
      transparent 0 42%,
      color-mix(in oklab, var(--c-space), transparent 45%) 76%,
      color-mix(in oklab, var(--c-space), transparent 8%) 100%
    );
  }

  /* Sao lấp lánh + sao băng (chỉ ban đêm) */
  .sky__stars {
    left: 0;
    top: 0;
    width: 2px;
    height: 2px;
    border-radius: 50%;
    background: var(--c-paper);
    box-shadow:
      14px 28px var(--c-paper), 36px 112px var(--c-paper), 22px 168px var(--c-paper), 188px 36px var(--c-paper),
      206px 98px var(--c-paper), 168px 8px var(--c-paper), 120px 22px var(--c-paper), 196px 176px var(--c-paper),
      58px 64px var(--c-paper), 150px 58px var(--c-paper);
    opacity: 0;
    transition: opacity var(--dur-slow);
  }
  :global(.dark) .sky__stars { opacity: 0.8; animation: twinkle 3.2s ease-in-out infinite; }
  .sky__meteor {
    left: 150px;
    top: 4px;
    width: 64px;
    height: 1.5px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--c-paper), transparent);
    rotate: -35deg;
    opacity: 0;
  }
  :global(.dark) .sky__meteor { animation: meteor 9s ease-in 2s infinite; }

  /* Hạt năng lượng từ Mặt Trời bay vào tấm pin của Orbi (chỉ ban ngày) */
  .sky__beam { left: 112px; top: 96px; transition: opacity var(--dur); }
  .sky__beam i {
    position: absolute;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--c-sun);
    box-shadow: 0 0 8px 2px color-mix(in oklab, var(--c-sun), transparent 40%);
    opacity: 0;
    animation: beam 2.4s ease-in infinite;
  }
  .sky__beam i:nth-child(2) { animation-delay: 0.8s; }
  .sky__beam i:nth-child(3) { animation-delay: 1.6s; }
  :global(.dark) .sky__beam { opacity: 0; }

  /* Orbi: ban ngày thức (bay cạnh Mặt Trời), ban đêm ngủ trên Mặt Trăng */
  .sky__orbi { transition: left var(--dur-slow) var(--ease-spring), top var(--dur-slow) var(--ease-spring), opacity var(--dur); }
  .sky__orbi :global(svg) { display: block; }
  .sky__orbi--awake { left: 12px; top: 116px; }
  .sky__bob { display: block; animation: bob 4s ease-in-out infinite; }
  .sky:hover .sky__orbi--awake { animation: flip 900ms var(--ease-spring); }
  /* Đang sạc: tấm pin sáng lên theo nhịp hạt năng lượng */
  :global(html:not(.dark)) .sky__orbi--awake :global(.o-solar) { animation: charge 0.8s ease-in-out infinite alternate; }

  .sky__orbi--sleep { left: 74px; top: 14px; opacity: 0; transform-origin: 50% 100%; }
  :global(.dark) .sky__orbi--sleep { opacity: 1; animation: rock 6s ease-in-out infinite; }
  :global(.dark) .sky__orbi--awake { left: 74px; top: 14px; opacity: 0; }
  /* Rê chuột ban đêm: Orbi thức dậy, nhảy lên */
  :global(.dark) .sky:hover .sky__orbi--sleep { opacity: 0; }
  :global(.dark) .sky:hover .sky__orbi--awake { opacity: 1; animation: hop 700ms var(--ease-spring); }

  /* Đổi giao diện: Mặt Trời lặn xuống, Mặt Trăng mọc lên */
  :global(.dark) .sun { opacity: 0; translate: 0 28px; scale: 0.85; }
  :global(.dark) .moon { opacity: 1; translate: 0 0; }

  @keyframes sky-spin { to { rotate: 360deg; } }
  @keyframes sky-roll { to { transform: translateX(-50%); } }
  @keyframes corona { 50% { scale: 1.08; opacity: 0.7; } }
  @keyframes sun-glow { 50% { box-shadow: 0 0 0 1.5px color-mix(in oklab, var(--c-signal), transparent 55%), 0 0 60px 14px color-mix(in oklab, var(--c-sun), transparent 55%); } }
  @keyframes twinkle { 50% { opacity: 0.35; } }
  @keyframes meteor {
    0% { opacity: 0; translate: 0 0; }
    3% { opacity: 1; }
    9% { opacity: 0; translate: -120px 84px; }
    100% { opacity: 0; translate: -120px 84px; }
  }
  @keyframes beam {
    0% { opacity: 0; translate: 0 0; scale: 1; }
    20% { opacity: 1; }
    90% { opacity: 1; scale: 0.6; }
    100% { opacity: 0; translate: -40px 56px; scale: 0.4; }
  }
  @keyframes charge { to { fill: color-mix(in oklab, var(--c-aurora), white 45%); } }
  @keyframes bob { 50% { transform: translateY(-8px) rotate(3deg); } }
  @keyframes flip {
    40% { translate: 0 -18px; }
    to { rotate: 360deg; }
  }
  @keyframes rock {
    0%, 100% { rotate: -5deg; }
    50% { rotate: 5deg; }
  }
  @keyframes hop {
    0% { translate: 0 0; }
    45% { translate: 0 -22px; }
    100% { translate: 0 0; }
  }

  .foot__base {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    padding-block: var(--space-6);
    color: var(--fg-muted);
    font-size: 0.6875rem;
  }
  .foot__top { gap: 8px; font-size: inherit; font-weight: inherit; text-transform: inherit; letter-spacing: inherit; }
  .foot__top:hover { color: var(--fg); }
  .rocket { width: 18px; height: 24px; transition: transform var(--dur) var(--ease-spring); }
  .foot__top:hover .rocket { transform: translateY(-3px); }
  .flame { transform-origin: 12px 22px; transform: scaleY(0); transition: transform var(--dur-fast); }
  .foot__top:hover .flame { transform: scaleY(1); animation: flicker 0.15s infinite alternate; }
  .foot__top[data-launch] .rocket { transform: translateY(-120px); transition: transform 700ms cubic-bezier(0.5, 0, 0.9, 0.3); }

  @keyframes flicker { to { transform: scaleY(0.7); } }

  /* Màn vừa: email + menu bên trái, bầu trời bên phải */
  @media (max-width: 1100px) {
    .foot__grid { grid-template-columns: minmax(0, 1fr) auto; }
    .sky { grid-column: 2; grid-row: 1 / span 2; }
  }
  @media (max-width: 640px) {
    .foot__grid { grid-template-columns: minmax(0, 1fr); }
    .sky { grid-column: auto; grid-row: auto; justify-self: center; }
    .foot__nav ul { gap: 6px var(--space-6); }
    .foot__base { flex-direction: column-reverse; align-items: flex-start; }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const btn = document.querySelector<HTMLButtonElement>('[data-to-top]');
    btn?.addEventListener('click', () => {
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      btn.setAttribute('data-launch', '');
      window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
      window.setTimeout(() => btn.removeAttribute('data-launch'), 1200);
    });
  });
</script>
