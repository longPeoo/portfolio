---
/**
 * Thanh điều hướng "Mission Control Bar": logo, menu, số người đang xem (chấm trạng thái + icon mắt),
 * nút đổi ngôn ngữ, nút nhạc nền, nút đổi giao diện sáng/tối và nút Liên hệ. Trên mobile chuyển thành menu toàn màn hình (shadcn Sheet).
 */
import { ArrowUpRightIcon, EyeIcon } from 'lucide-react';
import { getSite } from '@/lib/site';
import { getI18n, LOCALES, locales, localizePath, stripLocale } from '@/lib/i18n';
import { buttonVariants } from '@/components/ui/button';
import { cn, cleanPath } from '@/lib/utils';
import Orbi from '@/components/brand/Orbi.astro';
import { ThemeToggle } from './ThemeToggle';
import MusicToggle from './MusicToggle.astro';
import LanguageSwitch from './LanguageSwitch.astro';
import { MobileNav } from './MobileNav';

const { t, locale, path } = getI18n(Astro.url);
const site = getSite(locale);
const current = cleanPath(Astro.url.pathname);
const nav = site.nav.map((item) => ({ ...item, href: path(item.href) }));
const isActive = (href: string) => current === href || current.startsWith(`${href}/`);
const pad = (n: number) => String(n + 1).padStart(2, '0');
// Cho menu mobile (màn hình hẹp không còn chỗ trên header)
const base = stripLocale(current) === '/404' ? '/' : stripLocale(current);
const languages = locales.map((l) => ({ code: l, label: LOCALES[l].label, short: LOCALES[l].short, href: localizePath(base, l), active: l === locale }));
---

<header class="mbar" data-mbar>
  <a href={path('/')} class="mbar__brand" aria-label={`${site.name} — ${t.common.homeLabel}`}>
    <Orbi size={34} />
    <!-- Logo chữ Longpeoo: ảnh PNG dùng làm mask nên tự đổi màu theo giao diện sáng/tối -->
    <span class="mbar__wordmark" aria-hidden="true"></span>
  </a>

  <nav class="mbar__nav" aria-label={t.chrome.mainMenu}>
    <ul>
      {nav.map((item, i) => (
        <li>
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
            <span class="mono mbar__idx">{pad(i)}</span>{item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <!--
    Số người đang xem (src/scripts/live.ts): chấm trạng thái + icon mắt + con số, kiểu bộ đếm phát trực tiếp.
    Chữ "đang xem" chỉ dành cho trình đọc màn hình. Không kết nối được thì ẩn icon và số, chỉ còn chấm trạng thái.
  -->
  <div class="mbar__tele mono">
    <span class="mbar__status" aria-hidden="true"></span>
    <span class="mbar__live" data-live title={t.chrome.live}>
      <EyeIcon className="mbar__eye" aria-hidden="true" />
      <span class="mbar__count" data-live-count>--</span>
      <span class="sr-only">{t.chrome.live}</span>
    </span>
  </div>

  <div class="mbar__actions">
    <LanguageSwitch />
    <MusicToggle />
    <ThemeToggle label={t.chrome.theme} />
    <a href={path('/contact')} class={cn(buttonVariants({ variant: 'ink', size: 'lg' }), 'mbar__cta')}>
      {t.common.contact} <ArrowUpRightIcon data-icon="inline-end" />
    </a>
    <div class="mbar__burger">
      <MobileNav
        client:media="(max-width: 860px)"
        items={nav}
        contactHref={path('/contact')}
        languages={languages}
        socials={site.socials}
        email={site.email}
        currentPath={current}
        labels={{ contact: t.common.contact, openMenu: t.chrome.openMenu, closeMenu: t.chrome.closeMenu, mainMenu: t.chrome.mainMenu, language: t.chrome.language }}
      />
    </div>
  </div>
</header>

<style>
  .mbar {
    position: fixed;
    inset: 0 0 auto;
    z-index: 40; /* dưới Sheet (z-50) để menu mobile phủ lên được */
    height: var(--header-h);
    display: flex;
    align-items: center;
    gap: clamp(12px, 2vw, 32px);
    padding-inline: var(--gutter);
    border-bottom: 1px solid transparent;
    transition: background-color var(--dur), border-color var(--dur), transform var(--dur) var(--ease-out);
  }
  .mbar[data-scrolled] {
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    backdrop-filter: blur(12px) saturate(1.2);
    border-color: var(--line);
  }

  .mbar__brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }
  .mbar__brand :global(.orbi) { transition: transform var(--dur) var(--ease-spring); }
  .mbar__brand:hover :global(.orbi) { transform: rotate(-12deg) scale(1.08); }
  .mbar__wordmark {
    display: block;
    height: 24px;
    aspect-ratio: 740 / 160;
    background-color: var(--fg);
    -webkit-mask: url('/brand/longpeoo-wordmark.webp') center / contain no-repeat;
    mask: url('/brand/longpeoo-wordmark.webp') center / contain no-repeat;
    transition: background-color var(--dur);
  }
  .mbar__brand:hover .mbar__wordmark { background-color: var(--primary); }

  .mbar__nav { margin-inline: auto; }
  .mbar__nav ul { display: flex; gap: clamp(8px, 1.6vw, 26px); list-style: none; padding: 0; }
  .mbar__nav a {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 6px;
    padding: 6px 2px;
    font-size: var(--fs-sm);
    font-weight: 500;
    text-decoration: none;
  }
  .mbar__idx { font-size: 0.625rem; color: var(--fg-muted); }
  /* Chấm "quỹ đạo" đánh dấu trang hiện tại */
  .mbar__nav a::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -4px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--primary);
    transform: translateX(-50%) scale(0);
    transition: transform var(--dur) var(--ease-spring);
  }
  .mbar__nav a:hover::after { transform: translateX(-50%) scale(0.6); }
  .mbar__nav a[aria-current='page']::after { transform: translateX(-50%) scale(1); }

  .mbar__tele {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--fg-muted);
    font-size: 0.6875rem;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .mbar__status {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ok);
    box-shadow: 0 0 0 0 var(--ok);
    animation: ping 2.4s var(--ease-out) infinite;
  }
  .mbar__live { display: inline-flex; align-items: center; gap: 5px; }
  .mbar__live[data-off] { display: none; }
  .mbar__tele :global(.mbar__eye) { width: 14px; height: 14px; }
  .mbar__count { display: inline-block; min-width: 2ch; color: var(--fg); font-weight: 600; }
  .mbar__count.is-tick { animation: live-tick 480ms var(--ease-spring); }
  @keyframes live-tick {
    40% { transform: translateY(-3px) scale(1.15); color: var(--primary); }
  }

  .mbar__actions { display: flex; align-items: center; gap: 8px; }
  .mbar__burger { display: none; }

  @media (max-width: 1080px) {
    .mbar__tele { display: none; }
  }
  @media (max-width: 860px) {
    .mbar__nav, .mbar__cta { display: none; }
    .mbar__actions { margin-left: auto; }
    .mbar__burger { display: block; }
  }

  @keyframes ping {
    0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--ok) 60%, transparent); }
    70%, 100% { box-shadow: 0 0 0 7px transparent; }
  }
</style>

<script>
  import { initLive } from '@/scripts/live';

  // Listener gắn vào window/document được gỡ mỗi khi chuyển trang để không bị chồng
  let pageListeners: AbortController | undefined;

  /**
   * Bấm VI / EN (header hoặc menu mobile): ghi nhớ lựa chọn (BaseLayout không tự đổi theo trình duyệt nữa)
   * và giữ nguyên ?query, #hash của trang hiện tại. Bắt ở pha capture để chạy trước bộ định tuyến của Astro.
   */
  function initLanguage() {
    document.addEventListener(
      'click',
      (e) => {
        const link = (e.target as Element | null)?.closest<HTMLAnchorElement>('a[data-lang]');
        if (!link || link.getAttribute('aria-current')) return;
        try {
          localStorage.setItem('lang', link.dataset.lang!);
        } catch {}
        const url = new URL(link.href);
        url.search = location.search;
        url.hash = location.hash;
        link.href = url.href;
      },
      { capture: true, signal: pageListeners?.signal },
    );
  }

  function initScrollState() {
    const bar = document.querySelector<HTMLElement>('[data-mbar]');
    if (!bar) return;
    const update = () => bar.toggleAttribute('data-scrolled', window.scrollY > 8);
    update();
    window.addEventListener('scroll', update, { passive: true, signal: pageListeners?.signal });
  }

  function initThemeToggle() {
    document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      try {
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      } catch {}
    });
  }

  document.addEventListener('astro:page-load', () => {
    pageListeners?.abort();
    pageListeners = new AbortController();
    initLanguage();
    initScrollState();
    initThemeToggle();
    initLive();
  });
</script>
