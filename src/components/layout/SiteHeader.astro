---
import { site } from '@/lib/site';
import { buttonVariants } from '@/components/ui/button';
import { cn } from '@/lib/utils';
import Orbi from '@/components/brand/Orbi.astro';
import { ThemeToggle } from './ThemeToggle';
import { MobileNav } from './MobileNav';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="sticky top-0 z-40 border-b bg-background/90 backdrop-blur supports-[backdrop-filter]:bg-background/75">
  <div class="mx-auto flex h-16 max-w-6xl items-center gap-6 px-4 sm:px-6 lg:px-8">
    <a href="/" class="group flex items-center gap-2.5" aria-label={`${site.name}, về trang chủ`}>
      <Orbi size={30} decorative class="transition-transform duration-300 group-hover:-rotate-12" />
      <span class="font-heading text-xl font-extrabold tracking-tight [font-stretch:125%]">{site.name}</span>
    </a>

    <nav aria-label="Menu chính" class="ml-auto hidden md:block">
      <ul class="flex items-center gap-1">
        {site.nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class={cn(
                buttonVariants({ variant: 'ghost', size: 'sm' }),
                'text-[0.9rem] text-muted-foreground aria-[current=page]:bg-secondary aria-[current=page]:text-secondary-foreground',
              )}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-1 md:ml-0">
      <ThemeToggle client:load />
      <a href="/contact" class={cn(buttonVariants({ size: 'lg' }), 'hidden md:inline-flex')}>Liên hệ</a>
      <div class="md:hidden">
        <MobileNav
          client:media="(max-width: 767px)"
          items={site.nav}
          socials={site.socials}
          email={site.email}
          currentPath={path}
        />
      </div>
    </div>
  </div>
</header>
