---
/**
 * Icon từ bộ Remix Icon — render thành SVG ngay lúc build (không tốn JS).
 * Tra tên icon tại https://remixicon.com
 */
import { getIconData, iconToSVG } from '@iconify/utils';
import ri from '@iconify-json/ri/icons.json';

interface Props {
  name: string;
  size?: string | number;
  label?: string;
  class?: string;
}

const { name, size = '1.25em', label, class: className } = Astro.props;
const data = getIconData(ri, name);
if (!data) throw new Error(`Icon "${name}" không có trong bộ Remix Icon`);
const { attributes, body } = iconToSVG(data, { height: String(size) });
---

<svg
  {...attributes}
  class={className}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  fill="currentColor"
  set:html={body}
/>
