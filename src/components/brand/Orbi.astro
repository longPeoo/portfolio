---
/**
 * Orbi — linh vật vệ tinh nhỏ của website.
 * mood: happy (mặc định), sleep (footer), lost (trang 404)
 * Chỉ chớp mắt — không có chuyển động tự chạy nào khác (xem SKILLS.md, mục Chuyển động).
 */
interface Props {
  size?: number;
  mood?: 'happy' | 'sleep' | 'lost';
  class?: string;
  /** Ẩn với trình đọc màn hình khi Orbi chỉ để trang trí */
  decorative?: boolean;
}

const { size = 120, mood = 'happy', class: className, decorative = false } = Astro.props;
---

<svg
  class:list={['orbi', className]}
  width={size}
  height={Math.round(size * (110 / 120))}
  viewBox="0 0 120 110"
  role={decorative ? undefined : 'img'}
  aria-label={decorative ? undefined : 'Orbi, chú vệ tinh nhỏ'}
  aria-hidden={decorative ? 'true' : undefined}
>
  <line x1="60" y1="26" x2="60" y2="11" class="o-ink" stroke-width="3" stroke-linecap="round" />
  <circle cx="60" cy="9" r="5.5" class="o-beacon" />

  <line x1="27" y1="60" x2="20" y2="60" class="o-ink" stroke-width="3" />
  <rect x="3" y="46" width="18" height="28" rx="3" class="o-solar" />
  <path d="M12 46v28M3 55.5h18M3 65h18" class="o-grid" />
  <line x1="93" y1="60" x2="100" y2="60" class="o-ink" stroke-width="3" />
  <rect x="99" y="46" width="18" height="28" rx="3" class="o-solar" />
  <path d="M108 46v28M99 55.5h18M99 65h18" class="o-grid" />

  <circle cx="60" cy="60" r="34" class="o-body" />
  <path d="M29 72 Q60 92 91 72" class="o-strap" />
  <rect x="53" y="80" width="14" height="10" rx="2.5" class="o-cam" />
  <circle cx="60" cy="85" r="2.6" class="o-lens" />
  <rect x="37" y="42" width="46" height="30" rx="15" class="o-visor" />

  {mood === 'sleep' ? (
    <path d="M46 58 q5 4 10 0 M64 58 q5 4 10 0" class="o-line" />
  ) : mood === 'lost' ? (
    <g>
      <circle cx="51" cy="56" r="4" class="o-eye" />
      <circle cx="69" cy="56" r="2.6" class="o-eye" />
      <path d="M54 66 q3 -3 6 0 q3 3 6 0" class="o-line" />
    </g>
  ) : (
    <g>
      <g class="o-eyes">
        <ellipse cx="51" cy="55" rx="3.6" ry="4.8" class="o-eye" />
        <ellipse cx="69" cy="55" rx="3.6" ry="4.8" class="o-eye" />
      </g>
      <path d="M55 63.5 q5 4.5 10 0" class="o-line" />
    </g>
  )}

  <ellipse cx="42" cy="76" rx="4.5" ry="2.6" class="o-cheek" />
  <ellipse cx="78" cy="76" rx="4.5" ry="2.6" class="o-cheek" />
</svg>

<style>
  /* Đặt trong layer để class Tailwind truyền từ ngoài vào (max-w-*, rotate-*) vẫn thắng */
  @layer components {
    .orbi { overflow: visible; --o-ink: #121a45; }
    .o-ink { stroke: var(--o-ink); }
    .o-beacon { fill: var(--brand-flag); stroke: var(--o-ink); stroke-width: 2.5; }
    .o-solar { fill: var(--brand-sky); stroke: var(--o-ink); stroke-width: 2.5; }
    .o-grid { stroke: var(--o-ink); stroke-width: 1.4; opacity: 0.45; fill: none; }
    .o-body { fill: #fffdf7; stroke: var(--o-ink); stroke-width: 3; }
    .o-strap { fill: none; stroke: var(--brand-flag); stroke-width: 4; stroke-linecap: round; }
    .o-cam { fill: var(--o-ink); }
    .o-lens { fill: var(--brand-marigold); }
    .o-visor { fill: var(--brand-deep-space); stroke: var(--o-ink); stroke-width: 2.5; }
    .o-eye { fill: #fff; }
    .o-line { fill: none; stroke: #fff; stroke-width: 2.2; stroke-linecap: round; }
    .o-cheek { fill: #ff9a8a; opacity: 0.7; }

    .o-eyes { transform-origin: 60px 55px; animation: blink 6s infinite; }
    @keyframes blink {
      0%, 94%, 100% { transform: scaleY(1); }
      97% { transform: scaleY(0.1); }
    }
  }
</style>
