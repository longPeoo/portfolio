---
import { t } from '@/lib/i18n';
/**
 * Orbi — linh vật vệ tinh nhỏ của website.
 * mood: happy (mặc định) · sleep (ngủ, dùng ở footer) · lost (bối rối, dùng ở 404)
 */
interface Props {
  size?: number;
  mood?: 'happy' | 'sleep' | 'lost';
  float?: boolean;
  class?: string;
}

const { size = 120, mood = 'happy', float = false, class: className } = Astro.props;
---

<svg
  class:list={['orbi', `orbi--${mood}`, { 'orbi--float': float }, className]}
  width={size}
  height={size * (110 / 120)}
  viewBox="0 0 120 110"
  role="img"
  aria-label={t.common.orbi}
>
  <!-- Ăng-ten + đèn hiệu -->
  <line x1="60" y1="26" x2="60" y2="11" class="o-stroke" stroke-width="3" stroke-linecap="round" />
  <circle cx="60" cy="9" r="5.5" class="o-beacon" />

  <!-- Tấm pin trái -->
  <g class="o-panel o-panel--l">
    <line x1="27" y1="60" x2="20" y2="60" class="o-stroke" stroke-width="3" />
    <rect x="3" y="46" width="18" height="28" rx="3" class="o-solar" />
    <path d="M12 46v28M3 55.5h18M3 65h18" class="o-grid" />
  </g>
  <!-- Tấm pin phải -->
  <g class="o-panel o-panel--r">
    <line x1="93" y1="60" x2="100" y2="60" class="o-stroke" stroke-width="3" />
    <rect x="99" y="46" width="18" height="28" rx="3" class="o-solar" />
    <path d="M108 46v28M99 55.5h18M99 65h18" class="o-grid" />
  </g>

  <!-- Thân -->
  <circle cx="60" cy="60" r="34" class="o-body" />
  <!-- Dây đeo máy ảnh — chi tiết "travel" -->
  <path d="M29 72 Q60 92 91 72" class="o-strap" />
  <rect x="53" y="80" width="14" height="10" rx="2.5" class="o-cam" />
  <circle cx="60" cy="85" r="2.6" class="o-lens" />

  <!-- Kính mũ -->
  <rect x="37" y="42" width="46" height="30" rx="15" class="o-visor" />

  <!-- Khuôn mặt -->
  {mood === 'sleep' ? (
    <g class="o-face">
      <path d="M46 58 q5 4 10 0 M64 58 q5 4 10 0" class="o-line" />
      <text x="88" y="30" class="o-zzz">z</text>
      <text x="97" y="20" class="o-zzz o-zzz--2">z</text>
    </g>
  ) : mood === 'lost' ? (
    <g class="o-face">
      <circle cx="51" cy="56" r="4" class="o-eye" />
      <circle cx="69" cy="56" r="2.6" class="o-eye" />
      <path d="M54 66 q3 -3 6 0 q3 3 6 0" class="o-line" />
    </g>
  ) : (
    <g class="o-face">
      <g class="o-eyes">
        <ellipse cx="51" cy="55" rx="3.6" ry="4.8" class="o-eye" />
        <ellipse cx="69" cy="55" rx="3.6" ry="4.8" class="o-eye" />
      </g>
      <path d="M55 63.5 q5 4.5 10 0" class="o-line" />
    </g>
  )}

  <!-- Má hồng -->
  <ellipse cx="42" cy="76" rx="4.5" ry="2.6" class="o-cheek" />
  <ellipse cx="78" cy="76" rx="4.5" ry="2.6" class="o-cheek" />
</svg>

<style>
  .orbi {
    --o-ink: var(--c-ink);
    overflow: visible;
  }
  .o-stroke { stroke: var(--o-ink); }
  .o-beacon { fill: var(--c-signal); stroke: var(--o-ink); stroke-width: 2.5; transform-origin: 60px 9px; animation: beacon 2.4s ease-in-out infinite; }
  .o-solar { fill: var(--c-aurora); stroke: var(--o-ink); stroke-width: 2.5; }
  .o-grid { stroke: var(--o-ink); stroke-width: 1.4; opacity: 0.45; fill: none; }
  .o-body { fill: #fffaf0; stroke: var(--o-ink); stroke-width: 3; }
  .o-strap { fill: none; stroke: var(--c-signal); stroke-width: 4; stroke-linecap: round; }
  .o-cam { fill: var(--o-ink); }
  .o-lens { fill: var(--c-sun); }
  .o-visor { fill: var(--c-space); stroke: var(--o-ink); stroke-width: 2.5; }
  .o-eye { fill: #fff; }
  .o-line { fill: none; stroke: #fff; stroke-width: 2.2; stroke-linecap: round; }
  .o-cheek { fill: #ff9a7a; opacity: 0.75; }
  .o-zzz { font: 700 13px var(--font-mono); fill: var(--fg-muted); animation: zzz 3s ease-in-out infinite; }
  .o-zzz--2 { font-size: 10px; animation-delay: 0.6s; }

  .o-eyes { transform-origin: 60px 55px; animation: blink 5s infinite; }
  .o-panel--l { transform-origin: 24px 60px; animation: wave-l 6s var(--ease-out) infinite; }
  .o-panel--r { transform-origin: 96px 60px; animation: wave-r 6s var(--ease-out) infinite; }

  .orbi--float { animation: float 5s ease-in-out infinite; }
  .orbi--lost { animation: drift 9s ease-in-out infinite; }
  .orbi--sleep .o-panel { animation: none; }

  @keyframes blink {
    0%, 92%, 100% { transform: scaleY(1); }
    95% { transform: scaleY(0.1); }
  }
  @keyframes beacon {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.55; transform: scale(0.82); }
  }
  @keyframes wave-l {
    0%, 70%, 100% { transform: rotate(0); }
    78% { transform: rotate(-14deg); }
    86% { transform: rotate(6deg); }
  }
  @keyframes wave-r {
    0%, 70%, 100% { transform: rotate(0); }
    78% { transform: rotate(14deg); }
    86% { transform: rotate(-6deg); }
  }
  @keyframes float {
    0%, 100% { transform: translateY(0) rotate(-2deg); }
    50% { transform: translateY(-10px) rotate(2deg); }
  }
  @keyframes drift {
    0% { transform: translate(0, 0) rotate(-8deg); }
    50% { transform: translate(8px, -14px) rotate(10deg); }
    100% { transform: translate(0, 0) rotate(-8deg); }
  }
  @keyframes zzz {
    0% { opacity: 0; transform: translateY(4px); }
    40% { opacity: 1; }
    100% { opacity: 0; transform: translateY(-8px); }
  }
</style>
