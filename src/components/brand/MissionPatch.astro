---
/**
 * Mission patch — huy hiệu thêu tròn theo truyền thống các sứ mệnh không gian.
 * Đây là "điểm nhấn duy nhất" của ngôn ngữ thiết kế (xem SKILLS.md).
 *
 * motif: orbi (Orbi bay trên đường chân trời Trái Đất), orbit (vệ tinh quanh Trái Đất),
 *        trail (đường mòn lên núi — du lịch)
 * top/bottom: chữ thêu trên vành, chỉ hiện khi size ≥ 200
 * intro: chạy hiệu ứng "khâu" một lần khi tải trang (chỉ dùng cho patch ở hero)
 * tilt: patch nghiêng nhẹ theo con trỏ chuột (chuyển động do người dùng kích hoạt)
 * label: mô tả cho trình đọc màn hình; truyền "" khi patch chỉ để trang trí
 */
import Orbi from './Orbi.astro';

interface Props {
  motif?: 'orbi' | 'orbit' | 'trail';
  top?: string;
  bottom?: string;
  size?: number;
  intro?: boolean;
  tilt?: boolean;
  class?: string;
  label?: string;
}

const {
  motif = 'orbi',
  top,
  bottom,
  size = 320,
  intro = false,
  tilt = false,
  class: className,
  label = 'Huy hiệu sứ mệnh',
} = Astro.props;

const uid = `patch-${Math.random().toString(36).slice(2, 8)}`;
const showText = size >= 200 && (top || bottom);
const stars: [number, number, number][] = [
  [72, 62, 1.6], [128, 58, 1.2], [140, 88, 1.8], [62, 96, 1.1], [112, 46, 1], [86, 48, 1.3],
];
---

<div
  class:list={['patch', { 'patch--intro': intro }, className]}
  style={`--size:${size}px`}
  data-patch-tilt={tilt ? '' : undefined}
>
  <svg
    viewBox="0 0 200 200"
    role={label ? 'img' : undefined}
    aria-label={label || undefined}
    aria-hidden={label ? undefined : 'true'}
  >
    <defs>
      <clipPath id={`${uid}-disc`}><circle cx="100" cy="100" r="60" /></clipPath>
      <path id={`${uid}-top`} d="M 30,100 A 70,70 0 0 1 170,100" />
      <path id={`${uid}-bottom`} d="M 21,100 A 79,79 0 0 0 179,100" />
    </defs>

    <!-- Viền vắt sổ màu vàng + đường chỉ khâu -->
    <circle cx="100" cy="100" r="98" class="p-edge" />
    <circle cx="100" cy="100" r="93.5" class="p-stitch" pathLength="100" />
    <!-- Dải chữ -->
    <circle cx="100" cy="100" r="88" class="p-band" />

    {showText && (
      <g class="p-text">
        {top && <text><textPath href={`#${uid}-top`} startOffset="50%" text-anchor="middle">{top}</textPath></text>}
        {bottom && <text><textPath href={`#${uid}-bottom`} startOffset="50%" text-anchor="middle">{bottom}</textPath></text>}
        <path d="M17 100 l3 -6 l3 6 l-3 6 z M177 100 l3 -6 l3 6 l-3 6 z" class="p-sep" />
      </g>
    )}

    <!-- Đĩa trung tâm -->
    <circle cx="100" cy="100" r="62" class="p-ring" />
    <g clip-path={`url(#${uid}-disc)`}>
      <rect x="38" y="38" width="124" height="124" class="p-space" />
      {stars.map(([x, y, r]) => <circle cx={x} cy={y} r={r} class="p-star" />)}

      {motif === 'orbi' && (
        <g>
          <circle cx="100" cy="196" r="66" class="p-atmo" />
          <circle cx="100" cy="198" r="64" class="p-land" />
          <path d="M60 150 q14 -8 26 -2 q10 6 22 0 q12 -6 30 2" class="p-coast" />
          <g transform="translate(66 64) rotate(-8 34 31)">
            <Orbi size={68} decorative />
          </g>
        </g>
      )}

      {motif === 'orbit' && (
        <g>
          <circle cx="100" cy="104" r="28" class="p-atmo" />
          <circle cx="100" cy="104" r="26" class="p-land" />
          <path d="M84 96 q8 -6 14 0 q6 6 16 2 M80 112 q10 4 18 -2" class="p-coast" />
          <ellipse cx="100" cy="104" rx="52" ry="17" transform="rotate(-18 100 104)" class="p-orbit" />
          <g transform="translate(140 80) rotate(-18)">
            <rect x="-5" y="-4" width="10" height="8" rx="1.5" class="p-sat" />
            <rect x="-15" y="-3" width="8" height="6" class="p-panel" />
            <rect x="7" y="-3" width="8" height="6" class="p-panel" />
          </g>
        </g>
      )}

      {motif === 'trail' && (
        <g>
          <circle cx="128" cy="70" r="11" class="p-sun" />
          <path d="M30 168 L78 92 L104 128 L126 100 L172 168 Z" class="p-land" />
          <path d="M78 92 L88 108 L80 106 L72 112 Z" class="p-snow" />
          <path d="M60 160 q20 -8 18 -22 q-2 -12 14 -16 q12 -4 12 -18" class="p-trail" />
          <path d="M104 104 v-16 l12 4 l-12 4" class="p-flag" />
        </g>
      )}
    </g>
  </svg>
</div>

<style>
  /* Đặt trong layer để class Tailwind truyền từ ngoài vào (max-w-*, rotate-*) vẫn thắng */
  @layer components {
    .patch {
      width: var(--size);
      max-width: 100%;
      aspect-ratio: 1;
      transition: transform 400ms cubic-bezier(0.22, 1, 0.36, 1);
      will-change: transform;
    }
    .patch svg { width: 100%; height: 100%; overflow: visible; }

    .p-edge { fill: var(--brand-marigold); stroke: #c98a00; stroke-width: 1.5; }
    .p-stitch { fill: none; stroke: #fff6d6; stroke-width: 1.2; stroke-dasharray: 0.6 0.9; opacity: 0.9; }
    .p-band { fill: var(--brand-ultramarine); }
    .p-ring { fill: none; stroke: var(--brand-marigold); stroke-width: 3; }
    .p-space { fill: var(--brand-deep-space); }
    .p-star { fill: #fff; opacity: 0.85; }
    .p-text {
      fill: #fff;
      font-family: var(--font-heading);
      font-size: 12px;
      font-weight: 800;
      font-stretch: 112%;
      letter-spacing: 1.6px;
      text-transform: uppercase;
    }
    .p-sep { fill: var(--brand-marigold); }
    .p-atmo { fill: var(--brand-sky); }
    .p-land { fill: var(--brand-rice); }
    .p-coast { fill: none; stroke: #7fc4a1; stroke-width: 2; stroke-linecap: round; opacity: 0.8; }
    .p-orbit { fill: none; stroke: var(--brand-marigold); stroke-width: 1.6; stroke-dasharray: 3 4; }
    .p-sat { fill: #fffdf7; }
    .p-panel { fill: var(--brand-sky); }
    .p-sun { fill: var(--brand-marigold); }
    .p-snow { fill: #fffdf7; }
    .p-trail { fill: none; stroke: #fffdf7; stroke-width: 2; stroke-dasharray: 3 3.5; stroke-linecap: round; }
    .p-flag { fill: var(--brand-flag); stroke: #fffdf7; stroke-width: 1.2; stroke-linejoin: round; }

    /* Khoảnh khắc tải trang duy nhất: patch "được khâu" lên */
    /* Animation đặt trên svg (không phải wrapper) để không đè transform của hiệu ứng nghiêng */
    .patch--intro svg { animation: patch-in 900ms cubic-bezier(0.22, 1, 0.36, 1) both; }
    .patch--intro .p-stitch { stroke-dasharray: 100; animation: stitch 1400ms 250ms ease-out both; }
    @keyframes patch-in {
      from { opacity: 0; transform: scale(0.88) rotate(-10deg); }
      to { opacity: 1; transform: none; }
    }
    @keyframes stitch {
      from { stroke-dashoffset: 100; }
      to { stroke-dashoffset: 0; }
    }
  }
</style>

<script>
  // Nghiêng patch theo con trỏ — chỉ khi người dùng di chuột và không bật giảm chuyển động
  document.addEventListener('astro:page-load', () => {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (!matchMedia('(pointer: fine)').matches) return;
    document.querySelectorAll<HTMLElement>('[data-patch-tilt]').forEach((patch) => {
      const area = patch.closest<HTMLElement>('[data-tilt-area]') ?? patch;
      area.addEventListener('pointermove', (e) => {
        const r = patch.getBoundingClientRect();
        const dx = (e.clientX - (r.left + r.width / 2)) / window.innerWidth;
        const dy = (e.clientY - (r.top + r.height / 2)) / window.innerHeight;
        patch.style.transform = `rotate(${dx * 10}deg) translate(${dx * 8}px, ${dy * 8}px)`;
      });
      area.addEventListener('pointerleave', () => (patch.style.transform = ''));
    });
  });
</script>
