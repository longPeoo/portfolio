---
import { ArrowUpRightIcon } from 'lucide-react';
import { site, brandIconSvg } from '@/lib/site';
import { t } from '@/lib/i18n';
import { Badge } from '@/components/ui/badge';
import { buttonVariants } from '@/components/ui/button';
import { cn } from '@/lib/utils';
import Orbi from '@/components/brand/Orbi.astro';

const youtube = site.socials.find((s) => s.id === 'youtube');
// Quỹ đạo elip (toạ độ trong viewBox 600×600) — Orbi bay theo đường này
const orbitPath = 'M60 300 a240 110 0 1 0 480 0 a240 110 0 1 0 -480 0';
const stars = [
  [70, 90, 2.2], [520, 70, 1.6], [560, 420, 2.4], [110, 500, 1.4],
  [300, 40, 1.2], [460, 540, 1.8], [30, 260, 1.3], [585, 230, 1.1],
];
---

<section class="hero">
  <div class="container hero__inner">
    <div class="hero__meta mono">
      <span class="hero__greet">
        <span>{t.home.heroCode}</span>
        <!-- Số người đang xem (src/scripts/live.ts): chừa sẵn chỗ, có số mới hiện → không xô nội dung -->
        <span class="hero__live" data-live><i aria-hidden="true"></i><span data-live-count>--</span> {t.home.live}</span>
      </span>
      <span class="hero__flap"><span class="muted">{t.home.heroNow}</span><span class="flap" data-flap={JSON.stringify(site.roles)} role="img">{site.roles[0]}</span></span>
      <span class="muted">{site.location.lat} · {site.location.lon}</span>
    </div>

    <div class="hero__text">
      <p class="hero__hello">{t.home.hello}</p>
      <h1 class="hero__name" style={`--chars:${site.name.length}`}>{site.name}<span class="hero__dot">.</span></h1>
      <ul class="hero__roles" aria-label={t.home.rolesLabel}>
        {site.roles.map((r, i) => (
          <li><Badge variant={i === 0 ? 'telemetry-solid' : 'telemetry'}>{r}</Badge></li>
        ))}
      </ul>
      <p class="hero__tagline">{site.tagline}</p>
      <div class="hero__cta">
        <a href="/journeys" class={cn(buttonVariants({ variant: 'launch', size: 'pill' }))}>
          {t.home.ctaJourneys} <ArrowUpRightIcon data-icon="inline-end" />
        </a>
        <a
          href={youtube?.url ?? '/vlogs'}
          target={youtube ? '_blank' : undefined}
          rel={youtube ? 'noopener noreferrer' : undefined}
          class={cn(buttonVariants({ variant: 'launch-outline', size: 'pill' }))}
        >
          {t.home.ctaYoutube} <span data-icon="inline-end" class="contents" set:html={brandIconSvg('youtube-fill')} />
        </a>
      </div>
    </div>

    <div class="hero__orbit" aria-hidden="true" data-earth-root>
      <!-- Trái Đất + Mặt Trăng vẽ bằng WebGL (src/scripts/earth.ts), nằm dưới lớp SVG quỹ đạo -->
      <canvas class="earth" data-earth data-lat={site.location.lat} data-lon={site.location.lon}></canvas>
      <svg viewBox="0 0 600 600" class="orbit" data-orbit>
        <defs>
          <radialGradient id="sun-core" cx="42%" cy="40%" r="62%">
            <stop offset="0" stop-color="#fffbe8" />
            <stop offset="0.45" stop-color="var(--c-sun)" />
            <stop offset="1" stop-color="var(--c-signal)" />
          </radialGradient>
          <radialGradient id="sun-glow">
            <stop offset="0.35" stop-color="var(--c-sun)" stop-opacity="0.55" />
            <stop offset="1" stop-color="var(--c-sun)" stop-opacity="0" />
          </radialGradient>
        </defs>

        {stars.map(([x, y, r], i) => (
          <circle cx={x} cy={y} r={r} class="star" style={`animation-delay:${i * 0.45}s`} />
        ))}

        <!-- Mặt Trời SVG: bản dự phòng khi chưa tải xong / không có WebGL (bản thật vẽ trong earth.ts) -->
        <g class="sun">
          <circle cx="508" cy="92" r="78" fill="url(#sun-glow)" class="sun__glow" />
          <g class="sun__rays">
            {Array.from({ length: 12 }, (_, i) => (
              <path d="M508 36 v-12" transform={`rotate(${i * 30} 508 92)`} />
            ))}
          </g>
          <circle cx="508" cy="92" r="34" fill="url(#sun-core)" class="sun__core" />
        </g>

        <g transform="rotate(-18 300 300)">
          <!-- Hành tinh dạng lưới kinh-vĩ tuyến: hiện khi chưa tải xong Trái Đất / máy không có WebGL -->
          <g class="planet">
            <circle cx="300" cy="300" r="118" class="planet__body" />
            <ellipse cx="300" cy="300" rx="118" ry="38" class="planet__line" />
            <ellipse cx="300" cy="300" rx="46" ry="118" class="planet__line" />
            <ellipse cx="300" cy="300" rx="92" ry="118" class="planet__line" />
            <path d="M190 258 h220 M190 342 h220" class="planet__line" />
            <circle cx="338" cy="262" r="7" class="planet__pin" />
          </g>

          <path d={orbitPath} class="orbit__path" />
          <path d={orbitPath} class="orbit__trail" pathLength="100" />

          <g class="orbit__sat">
            <g transform="rotate(18) translate(-38 -35)">
              <Orbi size={76} />
            </g>
            <animateMotion dur="16s" repeatCount="indefinite" path={orbitPath} />
          </g>
        </g>
      </svg>
    </div>
  </div>
</section>

<style>
  /* Cao theo nội dung (khối quỹ đạo đã co theo chiều cao màn hình): phần kế tiếp ló lên ở mép dưới, gợi ý cuộn */
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    padding-top: calc(var(--header-h) + var(--space-6));
    padding-bottom: var(--space-8);
    overflow: hidden;
  }
  .hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    align-items: center;
    gap: var(--space-6);
  }
  .hero__meta {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: 1px dashed var(--line);
  }

  .hero__greet { display: flex; flex-wrap: wrap; align-items: center; gap: 4px var(--space-4); }
  .hero__live {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--ok);
    font-variant-numeric: tabular-nums;
    opacity: 0;
    transition: opacity var(--dur-slow) var(--ease-out);
  }
  .hero__live[data-ready] { opacity: 1; }
  .hero__live[data-off] { display: none; }
  .hero__live i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ok);
    animation: hero-ping 2.4s var(--ease-out) infinite;
  }
  .hero__live :global(.is-tick) { display: inline-block; animation: hero-tick 480ms var(--ease-spring); }
  @keyframes hero-ping {
    0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--ok) 60%, transparent); }
    70%, 100% { box-shadow: 0 0 0 7px transparent; }
  }
  @keyframes hero-tick {
    40% { transform: translateY(-3px) scale(1.15); color: var(--primary); }
  }
  .hero__flap { display: inline-flex; align-items: center; gap: 10px; }
  @media (max-width: 900px) { .hero__flap { display: none; } }
  .hero__text { grid-column: 1 / span 7; grid-row: 2; position: relative; z-index: 2; container-type: inline-size; }
  .hero__hello {
    font-style: italic;
    font-size: var(--fs-lg);
    color: var(--fg-muted);
  }
  /* Cỡ chữ tự co theo độ dài tên (--chars) để luôn nằm trên một dòng, kể cả khi đổi tên trong CMS */
  .hero__name {
    font-size: min(var(--fs-h1), calc(100cqi / (var(--chars) * 0.9 + 0.45)));
    white-space: nowrap;
    font-weight: 800;
    font-stretch: 125%;
    line-height: 0.9;
    letter-spacing: -0.045em;
    margin-block: 0.08em 0.18em;
  }
  .hero__dot { color: var(--primary); display: inline-block; animation: dot-pop 3.2s var(--ease-spring) infinite; }

  .hero__roles { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; padding: 0; }

  .hero__tagline { max-width: 34ch; margin-top: var(--space-6); font-size: var(--fs-lg); line-height: 1.55; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: var(--space-8); }

  /* Quỹ đạo nằm cùng hàng và chồng nhẹ lên phần chữ — bố cục kiểu tạp chí */
  /* Khối quỹ đạo vuông: giới hạn theo chiều cao màn hình để cả hero (chữ + nút) luôn nằm gọn trong màn hình đầu */
  .hero__orbit {
    position: relative;
    grid-column: 6 / -1;
    grid-row: 2;
    justify-self: end;
    width: min(100% + var(--gutter), 100svh - var(--header-h) - 240px);
    min-width: min(100%, 420px);
    margin-right: calc(var(--gutter) * -1);
  }
  .orbit { position: relative; display: block; width: 100%; height: auto; overflow: visible; }
  .earth { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; transition: opacity 1.2s var(--ease-out); }
  .has-earth .earth { opacity: 1; }
  .planet { transition: opacity 0.8s var(--ease-out); }
  .has-earth .planet { opacity: 0; }

  .sun { transition: opacity var(--dur-slow) var(--ease-out), translate var(--dur-slow) var(--ease-out); }
  :global(.dark) .sun { opacity: 0; translate: 30px 30px; }
  /* Có WebGL: Mặt Trời thật vẽ trong canvas (earth.ts), ẩn bản SVG dự phòng */
  .has-earth .sun { opacity: 0; }
  .sun__rays path { stroke: var(--c-sun); stroke-width: 4; stroke-linecap: round; }
  .sun__rays { transform-origin: 508px 92px; animation: sun-spin 40s linear infinite; }
  .sun__glow { transform-origin: 508px 92px; animation: sun-pulse 5s ease-in-out infinite; }
  .sun__core { stroke: var(--c-ink); stroke-width: 2; }
  @keyframes sun-spin { to { rotate: 360deg; } }
  @keyframes sun-pulse { 50% { scale: 1.12; opacity: 0.75; } }

  .star { fill: var(--fg); opacity: 0.5; animation: twinkle 3.6s ease-in-out infinite; }
  .planet__body { fill: var(--bg-elev); stroke: var(--fg); stroke-width: 2; }
  .planet__line { fill: none; stroke: var(--fg); stroke-width: 1; opacity: 0.28; }
  .planet__pin { fill: var(--primary); stroke: var(--fg); stroke-width: 2; }
  .planet { transform-origin: 300px 300px; animation: wobble 14s ease-in-out infinite; }

  .orbit__path { fill: none; stroke: var(--fg); stroke-width: 1.4; stroke-dasharray: 2 9; stroke-linecap: round; opacity: 0.55; }
  .orbit__trail {
    fill: none;
    stroke: var(--primary);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 14 86;
    animation: trail 16s linear infinite;
  }

  @keyframes trail { to { stroke-dashoffset: -100; } }
  @keyframes twinkle { 0%, 100% { opacity: 0.15; } 50% { opacity: 0.75; } }
  @keyframes wobble { 0%, 100% { transform: rotate(0); } 50% { transform: rotate(6deg); } }
  @keyframes dot-pop {
    0%, 80%, 100% { transform: none; }
    88% { transform: translateY(-0.12em) scale(1.15); }
  }

  @media (min-width: 901px) {
    /* Bố cục tạp chí: tên lấn nhẹ sang vùng quỹ đạo */
    .hero__name { font-size: min(var(--fs-h1), calc(112cqi / (var(--chars) * 0.9 + 0.45))); }
  }

  @media (max-width: 900px) {
    .hero__text { grid-column: 1 / -1; grid-row: 3; }
    .hero__orbit {
      grid-column: 1 / -1;
      grid-row: 2;
      justify-self: center;
      width: min(100%, 420px);
      margin: calc(var(--space-8) * -1) 0 calc(var(--space-12) * -1);
    }
  }
</style>

<script>
  // animateMotion (SMIL) không bị CSS reduced-motion chặn → dừng thủ công
  document.addEventListener('astro:page-load', () => {
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    document.querySelectorAll<SVGSVGElement>('[data-orbit]').forEach((svg) => svg.pauseAnimations());
  });

  // Trái Đất WebGL: tải sau khi trang đã hiện xong (không làm chậm lần hiển thị đầu), gỡ khi chuyển trang
  let earthAbort: AbortController | undefined;
  document.addEventListener('astro:page-load', () => {
    earthAbort?.abort();
    const canvas = document.querySelector<HTMLCanvasElement>('[data-earth]');
    if (!canvas) return;
    const abort = (earthAbort = new AbortController());
    const start = () => {
      import('@/scripts/earth').then(({ mountEarth }) => {
        if (!abort.signal.aborted) mountEarth(canvas, abort.signal);
      });
    };
    const idle = () => ('requestIdleCallback' in window ? requestIdleCallback(start, { timeout: 2500 }) : setTimeout(start, 600));
    if (document.readyState === 'complete') idle();
    else window.addEventListener('load', idle, { once: true, signal: abort.signal });
  });
  document.addEventListener('astro:before-swap', () => earthAbort?.abort());
</script>
