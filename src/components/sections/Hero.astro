---
import { site, brandIconSvg } from '@/lib/site';
import { buttonVariants } from '@/components/ui/button';
import MissionPatch from '@/components/brand/MissionPatch.astro';

const youtube = site.socials.find((s) => s.id === 'youtube');
---

<section class="mx-auto max-w-6xl px-4 pt-10 pb-16 sm:px-6 md:pt-20 md:pb-24 lg:px-8" data-tilt-area>
  <div class="grid items-center gap-10 md:grid-cols-[1.3fr_1fr] md:gap-12">
    <div class="order-2 flex flex-col gap-6 md:order-1">
      <h1 class="type-display">{site.home.headline}</h1>
      <p class="type-lead max-w-[40ch] text-muted-foreground">{site.home.intro}</p>
      <div class="flex flex-wrap gap-3 pt-2">
        <a href="/journeys" class={buttonVariants({ size: 'xl' })}>{site.home.travel.cta}</a>
        <a
          href={youtube?.url ?? '/videos'}
          target={youtube ? '_blank' : undefined}
          rel={youtube ? 'noopener noreferrer' : undefined}
          class={buttonVariants({ size: 'xl', variant: 'secondary' })}
        >
          <span data-icon="inline-start" class="contents" set:html={brandIconSvg('youtube-fill')} />
          Kênh YouTube
        </a>
      </div>
    </div>

    <div class="order-1 flex justify-center md:order-2 md:justify-end">
      <MissionPatch
        motif="orbi"
        top={site.patch.top}
        bottom={site.patch.bottom}
        size={420}
        intro
        tilt
        class="max-w-[260px] sm:max-w-[320px] md:max-w-none"
        label={`Huy hiệu của ${site.name}: ${site.patch.top}, ${site.patch.bottom}`}
      />
    </div>
  </div>
</section>
