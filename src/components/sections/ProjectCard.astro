---
/**
 * Thẻ dự án ("payload"): shadcn Card + ảnh bìa.
 * Rê chuột: lưới bản vẽ kỹ thuật hiện lên trên ảnh, 4 góc ngắm vẽ ra, đèn trạng thái sáng.
 */
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { Badge } from '@/components/ui/badge';
import { Card, CardContent, CardDescription, CardFooter, CardHeader, CardTitle } from '@/components/ui/card';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
}

const { project, index } = Astro.props;
const { title, summary, role, date, tags, cover, coverAlt, status } = project.data;
const code = `PL-${String(index + 1).padStart(2, '0')}`;
---

<a href={`/engineering/${project.id}`} class="pcard" data-reveal>
  <Card className="h-full gap-5 pt-0">
    <div class="pcard__cover">
      {cover ? (
        <Image src={cover} alt={coverAlt} widths={[480, 800, 1200]} sizes="(min-width: 900px) 50vw, 100vw" transition:name={`project-${project.id}`} />
      ) : (
        <div class="pcard__blank" aria-hidden="true"></div>
      )}
      <span class="pcard__grid" aria-hidden="true"></span>
      <span class="pcard__corners" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
      <span class:list={['pcard__led mono', `is-${status.toLowerCase()}`]}><i aria-hidden="true"></i>{status}</span>
    </div>
    <CardHeader>
      <p class="mono muted">{code} · {date.getFullYear()}</p>
      <CardTitle className="font-heading text-2xl leading-tight font-bold">{title}</CardTitle>
      <CardDescription className="text-base">{summary}</CardDescription>
    </CardHeader>
    <CardContent>
      <p class="mono muted">Vai trò · {role}</p>
    </CardContent>
    {tags.length > 0 && (
      <CardFooter className="flex-wrap gap-2 border-t pt-4 pb-4">
        {tags.map((t) => <Badge variant="telemetry">{t}</Badge>)}
      </CardFooter>
    )}
  </Card>
</a>

<style>
  .pcard { display: block; text-decoration: none; height: 100%; transition: transform var(--dur) var(--ease-spring); }
  .pcard:hover { transform: translateY(-4px); }
  .pcard__cover { position: relative; aspect-ratio: 16 / 10; overflow: hidden; background: var(--c-space); }
  .pcard__cover :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform var(--dur-slow) var(--ease-out); }
  .pcard:hover .pcard__cover :global(img) { transform: scale(1.04); }
  .pcard__blank { position: absolute; inset: 0; background: var(--c-space-2); }

  /* Lưới bản vẽ kỹ thuật */
  .pcard__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.14) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.14) 1px, transparent 1px);
    background-size: 24px 24px;
    opacity: 0;
    transition: opacity var(--dur) var(--ease-out);
  }
  .pcard:hover .pcard__grid { opacity: 1; }

  /* 4 góc ngắm */
  .pcard__corners i {
    position: absolute;
    width: 18px;
    height: 18px;
    border: 2px solid var(--c-paper);
    opacity: 0;
    transform: scale(1.6);
    transition: transform var(--dur) var(--ease-spring), opacity var(--dur);
  }
  .pcard__corners i:nth-child(1) { top: 14px; left: 14px; border-right: 0; border-bottom: 0; }
  .pcard__corners i:nth-child(2) { top: 14px; right: 14px; border-left: 0; border-bottom: 0; }
  .pcard__corners i:nth-child(3) { bottom: 14px; left: 14px; border-right: 0; border-top: 0; }
  .pcard__corners i:nth-child(4) { bottom: 14px; right: 14px; border-left: 0; border-top: 0; }
  .pcard:hover .pcard__corners i { opacity: 1; transform: none; }

  /* Đèn trạng thái */
  .pcard__led {
    position: absolute;
    top: 14px;
    left: 50%;
    translate: -50% 0;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: var(--r-pill);
    background: rgb(11 16 38 / 0.72);
    color: var(--c-paper);
    font-size: 0.625rem;
    backdrop-filter: blur(6px);
  }
  .pcard__led i { width: 7px; height: 7px; border-radius: 50%; background: var(--c-paper); opacity: 0.4; transition: all var(--dur); }
  .pcard:hover .pcard__led.is-nominal i { background: var(--c-aurora); opacity: 1; box-shadow: 0 0 10px var(--c-aurora); }
  .pcard:hover .pcard__led.is-complete i { background: var(--c-signal); opacity: 1; box-shadow: 0 0 10px var(--c-signal); }
  .pcard:hover .pcard__led.is-research i { background: var(--c-sun); opacity: 1; box-shadow: 0 0 10px var(--c-sun); }
</style>
