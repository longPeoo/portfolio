---
/**
 * Bảng "Đo xa · Chuyến bay" ở cột phải trang Về tôi (chỉ hiện trên màn hình rộng).
 * Dính theo khi cuộn: tên lửa N tầng (N = số mốc timeline) bay theo quỹ đạo, mỗi mốc tách một tầng,
 * Trái Đất xa dần, trời tối dần; mốc cuối → vào quỹ đạo, Orbi bung ra.
 * Logic cuộn: initFlight() trong src/scripts/motion.ts (đọc các mốc [data-stage] của timeline).
 */
import Orbi from '@/components/brand/Orbi.astro';
import { t } from '@/lib/i18n';

interface Props {
  /** Số tầng tên lửa = số mốc trong timeline */
  stages: number;
}
const { stages } = Astro.props;

// Thân tên lửa cao ~78 đơn vị: chia đều cho các tầng (tối đa 18/tầng)
const stageH = Math.min(18, 64 / Math.max(1, stages));
const bodyW = 18;
const path = 'M70 382 C 78 286, 128 170, 292 92';
const stars = [
  [40, 60, 1.4], [96, 32, 1], [150, 78, 1.6], [210, 40, 1.1], [268, 150, 1.3], [300, 30, 1.5],
  [22, 150, 1], [190, 120, 1.2], [250, 210, 1], [120, 140, 0.9], [60, 230, 1.1], [290, 260, 0.9],
];
---

<aside class="flight" data-flight aria-hidden="true" style={`--p:0`}>
  <div class="flight__panel">
    <p class="mono flight__code"><i></i>{t.about.flightCode}</p>

    <svg viewBox="0 0 320 420" class="flight__scene">
      <defs>
        <!-- Trời tối dần từ đỉnh xuống khi lên cao -->
        <linearGradient id="flight-space" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="var(--c-space)" />
          <stop offset="0.7" stop-color="var(--c-space-2)" />
          <stop offset="1" stop-color="var(--c-space-2)" stop-opacity="0" />
        </linearGradient>
        <linearGradient id="flight-earth" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="var(--c-aurora-deep)" />
          <stop offset="0.35" stop-color="var(--c-space-2)" />
        </linearGradient>
        <clipPath id="flight-clip"><rect width="320" height="420" rx="14" /></clipPath>
      </defs>

      <g clip-path="url(#flight-clip)">
        <rect width="320" height="420" class="flight__sky" />
        <rect width="320" height="420" class="flight__space" fill="url(#flight-space)" />
        <g class="flight__stars">
          {stars.map(([x, y, r]) => <circle cx={x} cy={y} r={r} />)}
        </g>

        <!-- Trái Đất: xa dần và cong hơn khi lên cao -->
        <g class="flight__earth">
          <circle cx="160" cy="980" r="612" class="flight__atmo" />
          <circle cx="160" cy="980" r="600" fill="url(#flight-earth)" />
        </g>

        <path d={path} class="flight__path" />
        <path d={path} class="flight__path-done" pathLength="1" data-flight-path />

        <!-- Tên lửa vẽ đứng, mũi hướng lên; JS đặt vị trí + góc theo quỹ đạo -->
        <g class="flight__rocket" data-flight-rocket>
          <g data-flight-flame>
            <path class="flight__flame" d={`M${-bodyW / 2 + 3} 0 h${bodyW - 6} l${-(bodyW - 6) / 2} 22 Z`} />
          </g>
          {Array.from({ length: stages }, (_, i) => (
            <g class="flight__stage" data-flight-stage={i}>
              <rect x={-bodyW / 2} y={-(i + 1) * stageH} width={bodyW} height={stageH - 1.5} rx="2" class="flight__body" />
              {i === 0 && <path d={`M${-bodyW / 2} -4 l-7 8 v-12 Z M${bodyW / 2} -4 l7 8 v-12 Z`} class="flight__fin" />}
              <text x="0" y={-(i + 0.5) * stageH + 2.5} class="flight__num" text-anchor="middle">{i + 1}</text>
            </g>
          ))}
          <g class="flight__payload" data-flight-payload transform={`translate(0 ${-stages * stageH - 2})`}>
            <g class="flight__orbi"><Orbi size={30} /></g>
          </g>
        </g>
      </g>
      <rect width="320" height="420" rx="14" class="flight__frame" />
    </svg>

    <dl class="flight__readout mono">
      <div><dt>T+</dt><dd data-flight-t>00</dd></div>
      <div><dt>ALT</dt><dd><span data-flight-alt>000</span> <small>km</small></dd></div>
      <div><dt>VEL</dt><dd><span data-flight-vel>0.00</span> <small>km/s</small></dd></div>
    </dl>
    <p class="flight__event">
      <span class="mono flight__year" data-flight-year>T-00</span>
      <span data-flight-title data-pad={t.about.flightPad} data-orbit={t.about.flightOrbit}>{t.about.flightPad}</span>
    </p>
  </div>
</aside>

<style>
  .flight { display: none; }
  @media (min-width: 1100px) {
    .flight { display: block; position: sticky; top: calc(var(--header-h) + var(--space-6)); align-self: start; }
  }
  .flight__panel {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--bg-elev);
  }
  .flight__code { display: flex; align-items: center; gap: 8px; color: var(--fg-muted); font-size: 0.6875rem; }
  .flight__code i { width: 7px; height: 7px; border-radius: 50%; background: var(--ok); animation: flight-led 1.4s steps(2) infinite; }
  .flight__scene { display: block; width: 100%; height: auto; max-height: calc(100svh - var(--header-h) - 260px); }

  /* Trời: sáng ở mặt đất → tối dần thành vũ trụ theo --p (0 → 1) */
  .flight__sky { fill: var(--bg-sunken); }
  .flight__space { opacity: min(1, calc(var(--p) * 1.6)); }
  :global(.dark) .flight__space { opacity: calc(0.6 + var(--p) * 0.4); }
  .flight__stars circle { fill: var(--c-paper); opacity: calc(var(--p) * 0.9); }
  :global(.dark) .flight__stars circle { opacity: calc(0.35 + var(--p) * 0.65); }
  /* Thu nhỏ quanh đỉnh Trái Đất: đường chân trời giữ nguyên chỗ nhưng cong dần khi lên cao */
  .flight__earth { transform-box: view-box; transform-origin: 160px 380px; transform: scale(calc(1 - var(--p) * 0.62)); }
  .flight__atmo { fill: var(--c-aurora); opacity: 0.35; }
  .flight__frame { fill: none; stroke: var(--line); }

  .flight__path { fill: none; stroke: var(--c-paper); stroke-width: 1.4; stroke-dasharray: 2 7; stroke-linecap: round; opacity: calc(0.25 + var(--p) * 0.4); }
  :global(.dark) .flight__path { opacity: 0.55; }
  .flight__path-done { fill: none; stroke: var(--primary); stroke-width: 2.5; stroke-linecap: round; stroke-dasharray: 1; stroke-dashoffset: calc(1 - var(--p)); }

  .flight__body { fill: var(--c-paper); stroke: var(--c-ink); stroke-width: 1.5; }
  .flight__fin { fill: var(--c-signal); stroke: var(--c-ink); stroke-width: 1.2; stroke-linejoin: round; }
  .flight__num { font-family: var(--font-mono); font-size: 7px; fill: var(--c-ink); }
  .flight__flame { fill: var(--c-sun); transform-box: fill-box; transform-origin: 50% 0; animation: flight-flame 0.12s infinite alternate; }

  /* Tách tầng: tầng rơi xuống, xoay nhẹ rồi mờ đi */
  .flight__stage { transform-box: fill-box; transform-origin: 50% 50%; transition: transform 1.4s var(--ease-out), opacity 1.4s var(--ease-out); }
  .flight__stage.is-dropped { transform: translate(-10px, 60px) rotate(-38deg); opacity: 0; }
  /* Vị trí gốc đặt bằng CSS (không dùng thuộc tính transform) để chuyển động bung ra không bị lệch */
  .flight__orbi { transform: translate(-15px, -30px); transition: transform 0.9s var(--ease-spring); }
  .flight__payload.is-deployed .flight__orbi { transform: translate(-22px, -84px) rotate(10deg); }
  [data-flight-flame] { transition: transform 0.6s var(--ease-out), opacity 0.4s; }

  .flight__readout { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-2); margin: 0; }
  .flight__readout div { padding: var(--space-2) var(--space-3); border: 1px solid var(--line); border-radius: var(--r-sm); }
  .flight__readout dt { color: var(--fg-muted); font-size: 0.625rem; }
  .flight__readout dd { margin: 0; font-size: 1rem; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .flight__readout small { color: var(--fg-muted); font-size: 0.625rem; }
  .flight__event { display: flex; flex-direction: column; gap: 2px; min-height: 3.2em; }
  .flight__year { color: var(--signal-ink); font-size: 0.6875rem; }
  [data-flight-title] { font-family: var(--font-display); font-weight: 750; font-stretch: 112%; font-size: 1.125rem; line-height: 1.25; }

  @keyframes flight-flame { to { transform: scaleY(0.7); } }
  @keyframes flight-led { 50% { opacity: 0.25; } }
</style>
