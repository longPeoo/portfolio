---
import { Badge } from '@/components/ui/badge';
import { t } from '@/lib/i18n';
/** Bảng tiến độ xây website — gỡ section này khỏi trang chủ khi launch chính thức. */
// Danh sách giai đoạn sửa trong /admin → Chữ trên giao diện → Trang chủ
const phases = t.home.phases;
---

<section class="status container" aria-labelledby="status-title">
  <div class="status__head">
    <p class="mono muted">{t.home.statusCode}</p>
    <h2 id="status-title">{t.home.statusTitle}</h2>
  </div>
  <ol class="status__list">
    {phases.map((p) => (
      <li class:list={['status__row', `is-${p.state}`]}>
        <span class="mono status__code">{p.code}</span>
        <span class="status__name">{p.name}</span>
        <Badge variant={p.state}><i class="status__dot" aria-hidden="true"></i>{t.common.status[p.state]}</Badge>
      </li>
    ))}
  </ol>
</section>

<style>
  .status {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: var(--space-12);
    padding-block: var(--section-y);
    border-top: 1px dashed var(--line);
  }
  .status__head h2 { font-size: var(--fs-h3); margin-top: var(--space-3); max-width: 16ch; }
  .status__list { list-style: none; padding: 0; border-top: 1px solid var(--line); }
  .status__row {
    display: grid;
    grid-template-columns: 3rem 1fr auto;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--line);
  }
  .status__code { color: var(--fg-muted); }
  .status__name { font-weight: 500; }
  /* Chấm trạng thái trong Badge — màu lấy theo màu chữ của variant */
  .status__dot { width: 8px; height: 8px; border-radius: 50%; background: currentColor; }
  .is-queued .status__dot { opacity: 0.35; }
  .is-active .status__dot { animation: blink 1.2s steps(2) infinite; }
  .is-queued .status__name { color: var(--fg-muted); }

  @keyframes blink { 50% { opacity: 0.2; } }

  @media (max-width: 800px) {
    .status { grid-template-columns: 1fr; gap: var(--space-6); }
  }
</style>
