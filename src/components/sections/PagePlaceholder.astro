---
/** Trang chưa có nội dung — dùng component Empty của shadcn. */
import { site } from '@/lib/site';
import { buttonVariants } from '@/components/ui/button';
import { Empty, EmptyContent, EmptyDescription, EmptyHeader, EmptyMedia, EmptyTitle } from '@/components/ui/empty';
import MissionPatch from '@/components/brand/MissionPatch.astro';

interface Props {
  title: string;
  intro: string;
  motif?: 'orbi' | 'orbit' | 'trail';
}

const { title, intro, motif = 'orbi' } = Astro.props;
const youtube = site.socials.find((s) => s.id === 'youtube');
---

<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-24 lg:px-8">
  <Empty className="border bg-card py-16">
    <EmptyHeader>
      <EmptyMedia>
        <MissionPatch motif={motif} size={120} label="" />
      </EmptyMedia>
      <EmptyTitle>
        <h1 class="type-h2">{title}</h1>
      </EmptyTitle>
      <EmptyDescription>{intro} Trang này đang được hoàn thiện.</EmptyDescription>
    </EmptyHeader>
    <EmptyContent className="flex-row flex-wrap justify-center">
      <a href="/" class={buttonVariants({ size: 'lg' })}>Về trang chủ</a>
      {youtube && (
        <a href={youtube.url} target="_blank" rel="noopener noreferrer" class={buttonVariants({ size: 'lg', variant: 'outline' })}>
          Xem kênh YouTube
        </a>
      )}
    </EmptyContent>
  </Empty>
</section>
