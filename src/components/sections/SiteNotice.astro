---
/** Thông báo tiến độ — gỡ khỏi trang chủ khi các trang chính đã có nội dung. */
import { ConstructionIcon } from 'lucide-react';
import { Alert, AlertDescription, AlertTitle } from '@/components/ui/alert';
---

<section class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
  <Alert>
    <ConstructionIcon />
    <AlertTitle>Website đang được hoàn thiện</AlertTitle>
    <AlertDescription>
      Các trang Hành trình, Video và Ảnh sẽ lần lượt có nội dung trong vài tuần tới.
    </AlertDescription>
  </Alert>
</section>
