---
/** Khung tạm cho các trang chưa xây xong. */
import { ArrowUpRightIcon } from 'lucide-react';
import { Badge } from '@/components/ui/badge';
import { buttonVariants } from '@/components/ui/button';
import { cn } from '@/lib/utils';
import Orbi from '@/components/brand/Orbi.astro';

interface Props {
  code: string;
  title: string;
  intro: string;
  phase: string;
}

const { code, title, intro, phase } = Astro.props;
---

<section class="soon container">
  <div class="soon__text">
    <p class="mono muted">{code}</p>
    <h1>{title}</h1>
    <p class="soon__intro">{intro}</p>
    <p class="soon__eta">
      <Badge variant="signal"><i class="soon__dot" aria-hidden="true"></i>Đang lắp ráp · {phase}</Badge>
    </p>
    <a href="/" class={cn(buttonVariants({ variant: 'launch-outline', size: 'pill' }))}>
      Về trạm phóng <ArrowUpRightIcon data-icon="inline-end" />
    </a>
  </div>
  <div class="soon__art" aria-hidden="true">
    <div class="soon__ring"></div>
    <Orbi size={150} float />
  </div>
</section>

<style>
  .soon {
    min-height: 80svh;
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    align-items: center;
    gap: var(--space-12);
    padding-top: calc(var(--header-h) + var(--space-12));
  }
  h1 { font-size: var(--fs-h2); margin-block: var(--space-3) var(--space-6); }
  .soon__intro { max-width: 46ch; font-size: var(--fs-lg); color: var(--fg-muted); }
  .soon__eta { margin-block: var(--space-8); }
  .soon__dot { width: 7px; height: 7px; border-radius: 50%; background: currentColor; animation: blink 1.2s steps(2) infinite; }
  .soon__art { position: relative; display: grid; place-items: center; aspect-ratio: 1; }
  .soon__ring {
    position: absolute;
    inset: 12%;
    border: 1.5px dashed var(--line);
    border-radius: 50%;
    animation: spin 40s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes blink { 50% { opacity: 0.2; } }
  @media (max-width: 760px) {
    .soon { grid-template-columns: 1fr; }
    .soon__art { width: 60%; justify-self: center; grid-row: 1; }
  }
</style>
