---
/** Khung tạm cho các trang chưa xây xong. */
import Button from '@/components/ui/Button.astro';
import Orbi from '@/components/mascot/Orbi.astro';

interface Props {
  code: string;
  title: string;
  intro: string;
  phase: string;
}

const { code, title, intro, phase } = Astro.props;
---

<section class="soon container">
  <div class="soon__text">
    <p class="mono muted">{code}</p>
    <h1>{title}</h1>
    <p class="soon__intro">{intro}</p>
    <p class="mono soon__eta"><i aria-hidden="true"></i> Đang lắp ráp · {phase}</p>
    <Button href="/" variant="ghost" icon="arrow-right-up-line">Về trạm phóng</Button>
  </div>
  <div class="soon__art" aria-hidden="true">
    <div class="soon__ring"></div>
    <Orbi size={150} float />
  </div>
</section>

<style>
  .soon {
    min-height: 80svh;
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    align-items: center;
    gap: var(--space-12);
    padding-top: calc(var(--header-h) + var(--space-12));
  }
  h1 { font-size: var(--fs-h2); margin-block: var(--space-3) var(--space-6); }
  .soon__intro { max-width: 46ch; font-size: var(--fs-lg); color: var(--fg-muted); }
  .soon__eta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-block: var(--space-8);
    padding: 6px 12px;
    border: 1px dashed var(--accent);
    border-radius: var(--radius-pill);
    color: var(--accent);
  }
  .soon__eta i { width: 7px; height: 7px; border-radius: 50%; background: currentColor; animation: blink 1.2s steps(2) infinite; }
  .soon__art { position: relative; display: grid; place-items: center; aspect-ratio: 1; }
  .soon__ring {
    position: absolute;
    inset: 12%;
    border: 1.5px dashed var(--line);
    border-radius: 50%;
    animation: spin 40s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes blink { 50% { opacity: 0.2; } }
  @media (max-width: 760px) {
    .soon { grid-template-columns: 1fr; }
    .soon__art { width: 60%; justify-self: center; grid-row: 1; }
  }
</style>
