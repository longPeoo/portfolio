---
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/fraunces/full.css';
import '@fontsource/be-vietnam-pro/400.css';
import '@fontsource/be-vietnam-pro/400-italic.css';
import '@fontsource/be-vietnam-pro/500.css';
import '@fontsource/be-vietnam-pro/600.css';
import '@fontsource-variable/jetbrains-mono';
import '@/styles/global.css';

import { site } from '@/lib/site';
import MissionBar from '@/components/layout/MissionBar.astro';
import Footer from '@/components/layout/Footer.astro';

interface Props {
  /** Tiêu đề trang — bỏ trống ở trang chủ */
  title?: string;
  description?: string;
  /** Ảnh khi chia sẻ link (đường dẫn tuyệt đối hoặc tính từ /public) */
  image?: string;
  noindex?: boolean;
}

const { title, description = site.description, image, noindex = false } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} — ${site.roles.slice(0, 2).join(' & ')}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site).href : undefined;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  alternateName: site.handle,
  url: Astro.site?.href,
  jobTitle: site.roles[0],
  email: `mailto:${site.email}`,
  sameAs: site.socials.map((s) => s.url),
};
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#f4eee1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b1026" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

    <!-- Áp giao diện sáng/tối trước khi vẽ trang để không bị nháy -->
    <script is:inline>
      (() => {
        const apply = () => {
          let theme = null;
          try {
            theme = localStorage.getItem('theme');
          } catch {}
          if (theme !== 'light' && theme !== 'dark') {
            theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.documentElement.dataset.theme = theme;
        };
        apply();
        if (!window.__themeBound) {
          window.__themeBound = true;
          document.addEventListener('astro:after-swap', apply);
        }
      })();
    </script>

    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">Bỏ qua, đến nội dung chính</a>
    <MissionBar />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
