---
import { ClientRouter } from 'astro:transitions';
import '@/styles/global.css';

import { getSite } from '@/lib/site';
import { getI18n, LOCALES, locales, localizePath, stripLocale } from '@/lib/i18n';
import { cleanPath } from '@/lib/utils';
import { services } from '@/lib/services';
import MissionBar from '@/components/layout/MissionBar.astro';
import Footer from '@/components/layout/Footer.astro';
import Orbi from '@/components/brand/Orbi.astro';

interface Props {
  /** Tiêu đề trang — bỏ trống ở trang chủ */
  title?: string;
  description?: string;
  /** Ảnh khi chia sẻ link (đường dẫn tuyệt đối hoặc tính từ /public) */
  image?: string;
  noindex?: boolean;
  /** Dữ liệu cấu trúc schema.org riêng của trang (Article, CreativeWork…) */
  schema?: Record<string, unknown>;
}

const { t, locale } = getI18n(Astro.url);
const site = getSite(locale);
const { title, description = site.description, image, noindex = false, schema } = Astro.props;
const lang = LOCALES[locale];
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} — ${site.roles.slice(0, 2).join(' & ')}`;
const canonical = new URL(cleanPath(Astro.url.pathname), Astro.site);
// Cùng trang ở mọi ngôn ngữ (hreflang). x-default = tiếng Anh: người xem không dùng tiếng Việt lẫn tiếng Anh sẽ được chuyển sang bản này
const basePath = stripLocale(cleanPath(Astro.url.pathname));
const alternates = locales.map((l) => ({ hreflang: LOCALES[l].lang, href: new URL(localizePath(basePath, l), Astro.site).href }));
const xDefault = new URL(localizePath(basePath, 'en'), Astro.site).href;
const ogImage = new URL(image ?? '/brand/orbi-avatar.png', Astro.site).href;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  alternateName: site.handle,
  url: new URL(localizePath('/', locale), Astro.site).href,
  jobTitle: site.roles[0],
  email: `mailto:${site.email}`,
  sameAs: site.socials.map((s) => s.url),
};
---

<!doctype html>
<html lang={lang.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={xDefault} />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#f4eee1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b1026" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang.og} />
    {locales.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={LOCALES[l].og} />)}
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={title ?? site.name} />
    <!-- Trang có ảnh riêng (dự án, chuyến đi) → thẻ chia sẻ ảnh lớn -->
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="author" content={site.name} />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

    {/*
      Chọn ngôn ngữ ở trang đầu tiên của phiên (chạy trước khi vẽ trang, nên không thấy nháy):
      - Đã bấm VI/EN trước đây (localStorage 'lang') → dùng lựa chọn đó.
      - Chưa từng chọn → theo danh sách ngôn ngữ của trình duyệt (navigator.languages): gặp tiếng Việt hay tiếng Anh trước thì dùng nó;
        không có cả hai → tiếng Anh.
      - Lệch với trang đang mở → chuyển sang bản kia (location.replace, không thêm lịch sử; giữ ?query và #hash).
      - Chỉ một lần mỗi phiên (sessionStorage), nên bấm link sang ngôn ngữ khác trong lúc xem không bị kéo lại.
      - Bỏ qua bot/công cụ đo (Googlebot, Lighthouse…): máy tìm kiếm thấy đủ cả hai bản qua hreflang.
    */}
    <script is:inline>
      (() => {
        try {
          if (sessionStorage.getItem('lang-checked')) return;
          sessionStorage.setItem('lang-checked', '1');
          if (/bot|crawl|spider|slurp|lighthouse|pagespeed|headless|prerender|preview/i.test(navigator.userAgent)) return;
          const here = document.documentElement.lang;
          let want = null;
          try {
            want = localStorage.getItem('lang');
          } catch {}
          if (want !== 'vi' && want !== 'en') {
            want = 'en';
            for (const l of navigator.languages?.length ? navigator.languages : [navigator.language || '']) {
              const code = l.toLowerCase().split('-')[0];
              if (code === 'vi' || code === 'en') {
                want = code;
                break;
              }
            }
          }
          if (want === here) return;
          const alt = document.querySelector(`link[rel="alternate"][hreflang="${want}"]`);
          if (!alt) return;
          window.__langRedirect = true;
          document.documentElement.style.visibility = 'hidden';
          location.replace(alt.href + location.search + location.hash);
        } catch {}
      })();
    </script>

    <!-- Áp giao diện sáng/tối (class `dark` theo chuẩn shadcn) trước khi vẽ trang để không bị nháy -->
    <script is:inline>
      (() => {
        const apply = () => {
          let theme = null;
          try {
            theme = localStorage.getItem('theme');
          } catch {}
          const dark = theme ? theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.classList.toggle('dark', dark);
        };
        apply();
        if (!window.__themeBound) {
          window.__themeBound = true;
          document.addEventListener('astro:after-swap', apply);
        }
      })();
    </script>

    <!-- Màn đếm ngược chỉ chạy ở lần vào đầu tiên trong phiên (và không chạy khi bật giảm chuyển động) -->
    <script is:inline>
      try {
        if (!window.__langRedirect && !sessionStorage.getItem('boot') && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.documentElement.dataset.boot = 'pending';
        }
      } catch {}
    </script>

    <!--
      Thống kê lượt truy cập: Cloudflare Web Analytics (không cookie, không lưu IP → không cần bảng hỏi đồng ý).
      Đặt trong <head> nên chuyển trang (View Transitions) không tải lại; "spa": true để vẫn đếm từng trang.
      Token ở src/lib/services.ts, để trống thì không gắn.
    -->
    {services.analyticsToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: services.analyticsToken, spa: true })}
      ></script>
    )}

    <ClientRouter />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[200] focus:rounded-md focus:bg-primary focus:px-3.5 focus:py-2 focus:text-primary-foreground"
    >
      {t.common.skipLink}
    </a>
    <div class="preloader" data-preloader aria-hidden="true">
      <div class="preloader__pad">
        <p class="mono">{t.chrome.countdown}</p>
        <span class="preloader__count" data-count>3</span>
        <div class="preloader__rocket">
          <Orbi size={58} />
          <svg viewBox="0 0 24 32" width="46" height="62">
            <path d="M12 1c5 4 7 10 6 17l-3 3H9l-3-3C5 11 7 5 12 1Z" fill="var(--c-paper)" />
            <circle cx="12" cy="11" r="2.6" fill="var(--c-space)" />
            <path d="M6 18l-4 4 1 4 4-3M18 18l4 4-1 4-4-3" fill="var(--c-signal)" />
            <path class="preloader__flame" d="M9.5 22h5l-2.5 9Z" fill="var(--c-sun)" />
          </svg>
        </div>
        <p class="mono preloader__skip">{t.chrome.skipIntro}</p>
      </div>
    </div>

    <!-- Đồng hồ độ cao: cuộn trang = tên lửa leo lên quỹ đạo -->
    <div class="altimeter" data-altimeter aria-hidden="true">
      <span class="mono">ALT</span>
      <div class="altimeter__track"><span class="altimeter__fill"></span><span class="altimeter__rocket"></span></div>
      <span class="mono"><span data-alt>000</span> km</span>
    </div>

    <MissionBar />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import '@/scripts/motion';
    </script>
  </body>
</html>
