---
import { ArrowUpRightIcon } from 'lucide-react';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { buttonVariants } from '@/components/ui/button';
import { cn } from '@/lib/utils';
import { Empty, EmptyContent, EmptyDescription, EmptyHeader, EmptyMedia, EmptyTitle } from '@/components/ui/empty';
import Orbi from '@/components/brand/Orbi.astro';
---

<BaseLayout title="Lạc vào vũ trụ" noindex>
  <section class="lost container">
    <Empty>
      <EmptyHeader>
        <EmptyMedia>
          <Orbi size={170} mood="lost" />
        </EmptyMedia>
        <p class="mono muted">Error 404 · Signal lost</p>
        <EmptyTitle>
          <h1>Houston, chúng ta có vấn đề.</h1>
        </EmptyTitle>
        <EmptyDescription>Trang bạn tìm đã trôi ra khỏi quỹ đạo, hoặc chưa từng được phóng lên.</EmptyDescription>
      </EmptyHeader>
      <EmptyContent>
        <a href="/" class={cn(buttonVariants({ variant: 'launch', size: 'pill' }))}>
          Quay về trạm phóng <ArrowUpRightIcon data-icon="inline-end" />
        </a>
      </EmptyContent>
    </Empty>
  </section>
</BaseLayout>

<style>
  .lost {
    min-height: 88svh;
    display: flex;
    align-items: center;
    padding-top: var(--header-h);
  }
  h1 { font-size: var(--fs-h2); max-width: 14ch; margin-inline: auto; }
</style>
