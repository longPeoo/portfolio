---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { buttonVariants } from '@/components/ui/button';
import { Empty, EmptyContent, EmptyDescription, EmptyHeader, EmptyMedia, EmptyTitle } from '@/components/ui/empty';
import Orbi from '@/components/brand/Orbi.astro';
---

<BaseLayout title="Không tìm thấy trang" noindex>
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-24 lg:px-8">
    <Empty className="py-16">
      <EmptyHeader>
        <EmptyMedia>
          <Orbi size={140} mood="lost" decorative />
        </EmptyMedia>
        <EmptyTitle>
          <h1 class="type-h2">Không tìm thấy trang này</h1>
        </EmptyTitle>
        <EmptyDescription>
          Đường dẫn có thể đã bị đổi hoặc gõ nhầm. Hãy quay về trang chủ hoặc chọn một mục trong menu.
        </EmptyDescription>
      </EmptyHeader>
      <EmptyContent>
        <a href="/" class={buttonVariants({ size: 'lg' })}>Về trang chủ</a>
      </EmptyContent>
    </Empty>
  </section>
</BaseLayout>
