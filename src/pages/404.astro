---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
import Orbi from '@/components/mascot/Orbi.astro';
---

<BaseLayout title="Lạc vào vũ trụ" noindex>
  <section class="lost container">
    <Orbi size={170} mood="lost" />
    <p class="mono muted">Error 404 · Signal lost</p>
    <h1>Houston, chúng ta có vấn đề.</h1>
    <p class="muted">Trang bạn tìm đã trôi ra khỏi quỹ đạo, hoặc chưa từng được phóng lên.</p>
    <Button href="/" icon="arrow-right-up-line">Quay về trạm phóng</Button>
  </section>
</BaseLayout>

<style>
  .lost {
    min-height: 88svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    padding-top: var(--header-h);
    text-align: center;
  }
  h1 { font-size: var(--fs-h2); max-width: 14ch; }
  .lost > p:last-of-type { margin-bottom: var(--space-4); }
</style>
