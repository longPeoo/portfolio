---
import { ArrowUpRightIcon } from 'lucide-react';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { buttonVariants } from '@/components/ui/button';
import { cn } from '@/lib/utils';
import { Empty, EmptyContent, EmptyDescription, EmptyHeader, EmptyMedia, EmptyTitle } from '@/components/ui/empty';
import Orbi from '@/components/brand/Orbi.astro';
import { t } from '@/lib/i18n';
---

<BaseLayout title={t.notFound.metaTitle} noindex>
  <section class="lost container">
    <Empty>
      <EmptyHeader>
        <EmptyMedia>
          <Orbi size={170} mood="lost" />
        </EmptyMedia>
        <p class="mono muted">{t.notFound.code}</p>
        <EmptyTitle>
          <h1>{t.notFound.title}</h1>
        </EmptyTitle>
        <EmptyDescription>{t.notFound.text}</EmptyDescription>
      </EmptyHeader>
      <EmptyContent>
        <a href="/" class={cn(buttonVariants({ variant: 'launch', size: 'pill' }))}>
          {t.notFound.back} <ArrowUpRightIcon data-icon="inline-end" />
        </a>
      </EmptyContent>
    </Empty>
  </section>
</BaseLayout>

<style>
  .lost {
    min-height: 88svh;
    display: flex;
    align-items: center;
    padding-top: var(--header-h);
  }
  h1 { font-size: var(--fs-h2); max-width: 14ch; margin-inline: auto; }
</style>
