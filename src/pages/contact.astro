---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/ui/Icon.astro';
import Orbi from '@/components/mascot/Orbi.astro';
import { site } from '@/lib/site';
---

<BaseLayout title="Liên hệ" description={`Liên hệ hợp tác, tài trợ hoặc chỉ để chào ${site.name}.`}>
  <section class="contact container">
    <p class="mono muted">MSN-99 · Send a signal</p>
    <h1>Gửi một tín hiệu.<br /><em>Tôi luôn bắt sóng.</em></h1>
    <p class="contact__intro">
      Hợp tác dự án kỹ thuật, tài trợ video, gợi ý điểm đến, hay đơn giản là muốn nói chuyện về vũ trụ: cứ gửi email cho tôi nhé.
    </p>

    <a class="contact__mail" href={`mailto:${site.email}`}>
      <span class="dish" aria-hidden="true">
        <Orbi size={64} />
        <i></i><i></i><i></i>
      </span>
      {site.email}
      <Icon name="arrow-right-up-line" size="0.8em" />
    </a>

    {site.socials.length > 0 && (
      <ul class="contact__socials">
        {site.socials.map((s) => (
          <li>
            <a href={s.url} target="_blank" rel="noopener noreferrer">
              <Icon name={s.icon} size="1.4em" />
              <span>{s.label}</span>
              <Icon name="arrow-right-up-line" size="1em" class="arrow" />
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>

<style>
  .contact { padding-top: calc(var(--header-h) + var(--space-16)); }
  h1 { font-size: var(--fs-h2); margin-block: var(--space-3) var(--space-6); max-width: 18ch; }
  h1 em { color: var(--fg-muted); font-weight: 400; }
  .contact__intro { max-width: 52ch; font-size: var(--fs-lg); color: var(--fg-muted); }

  .contact__mail {
    display: inline-flex;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-12);
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1rem + 3vw, 3.5rem);
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .contact__mail:hover { color: var(--accent); }
  .dish { position: relative; flex: none; }
  /* Sóng tín hiệu lan ra khi rê chuột */
  .dish i {
    position: absolute;
    inset: 0;
    border: 2px solid var(--accent);
    border-radius: 50%;
    opacity: 0;
  }
  .contact__mail:hover .dish i { animation: wave 1.6s var(--ease-out) infinite; }
  .contact__mail:hover .dish i:nth-child(3) { animation-delay: 0.4s; }
  .contact__mail:hover .dish i:nth-child(4) { animation-delay: 0.8s; }
  @keyframes wave {
    from { opacity: 0.8; transform: scale(0.9); }
    to { opacity: 0; transform: scale(2.2); }
  }

  .contact__socials {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 0 var(--space-8);
    list-style: none;
    padding: 0;
    margin-top: var(--space-16);
    border-top: 1px solid var(--line);
  }
  .contact__socials a {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    font-weight: 500;
  }
  .contact__socials :global(.arrow) { margin-left: auto; transition: transform var(--dur) var(--ease-spring); }
  .contact__socials a:hover { color: var(--accent); }
  .contact__socials a:hover :global(.arrow) { transform: translate(3px, -3px); }
</style>
