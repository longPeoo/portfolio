---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SocialList } from '@/components/sections/SocialList';
import { site } from '@/lib/site';
---

<BaseLayout title="Liên hệ" description={`Liên hệ hợp tác, tài trợ video hoặc chỉ để chào ${site.name}.`}>
  <section class="mx-auto flex max-w-3xl flex-col gap-6 px-4 py-16 sm:px-6 md:py-24">
    <h1 class="type-display">Liên hệ</h1>
    <p class="type-lead text-muted-foreground">
      Hợp tác dự án kỹ thuật, tài trợ video, gợi ý điểm đến hay đơn giản là muốn nói chuyện về vũ trụ: gửi email cho tôi, tôi thường trả lời trong vài ngày.
    </p>
    <a
      href={`mailto:${site.email}`}
      class="w-fit font-heading text-[clamp(1.5rem,1rem+2.5vw,2.5rem)] font-bold [font-stretch:112%] text-primary underline decoration-highlight decoration-[3px] underline-offset-8 hover:decoration-[6px]"
    >
      {site.email}
    </a>
    {site.socials.length > 0 && (
      <div class="mt-6 flex flex-col gap-3">
        <h2 class="type-h3">Mạng xã hội</h2>
        <SocialList socials={site.socials} />
      </div>
    )}
  </section>
</BaseLayout>
