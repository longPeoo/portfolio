---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ComingSoon from '@/components/sections/ComingSoon.astro';
import PageHeader from '@/components/sections/PageHeader.astro';
import { VideoGrid } from '@/components/media/VideoGrid';
import { getVideos, videoCategories, channelUrl } from '@/lib/youtube';
import { buttonVariants } from '@/components/ui/button';
import { cn } from '@/lib/utils';
import { brandIconSvg } from '@/lib/site';
import { t, intl } from '@/lib/i18n';

const videos = await getVideos();
const grid = videos.map((v) => ({
  id: v.id,
  title: v.title,
  published: v.published.toISOString(),
  views: v.views,
  url: v.url,
  categories: v.categories,
}));
const { title, intro, code } = t.videos;
---

<BaseLayout title={title} description={intro}>
  {grid.length === 0 ? (
    <ComingSoon code={code} title={title} intro={intro} />
  ) : (
    <>
      <PageHeader code={code} title={title} intro={intro}>
        {channelUrl && (
          <a href={channelUrl} target="_blank" rel="noopener noreferrer" class={cn(buttonVariants({ variant: 'launch', size: 'pill' }), 'subscribe')}>
            {t.videos.subscribe} <span data-icon="inline-end" class="contents" set:html={brandIconSvg('youtube-fill')} />
          </a>
        )}
      </PageHeader>
      <section class="container">
        <VideoGrid client:visible videos={grid} categories={videoCategories} labels={t.videos} intl={intl} />
      </section>
    </>
  )}
</BaseLayout>

<style>
  .subscribe { margin-top: var(--space-8); }
</style>
