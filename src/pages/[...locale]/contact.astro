---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ArrowUpRightIcon } from 'lucide-react';
import Orbi from '@/components/brand/Orbi.astro';
import { SocialList } from '@/components/sections/SocialList';
import MessageForm from '@/components/sections/MessageForm.astro';
import { getSite } from '@/lib/site';
import { getI18n, localeParams, fmt } from '@/lib/i18n';

export function getStaticPaths() {
  return localeParams();
}

const { t, locale } = getI18n(Astro.url);
const site = getSite(locale);
---

<BaseLayout title={t.contact.metaTitle} description={fmt(t.contact.metaDescription, { name: site.name })}>
  <section class="contact container">
    <p class="mono muted">{t.contact.code}</p>
    <h1>{t.contact.title}<br /><em>{t.contact.titleEm}</em></h1>
    <p class="contact__intro">{t.contact.intro}</p>

    <a class="contact__mail" href={`mailto:${site.email}`} style={`--mail-chars: ${site.email.length}`}>
      <span class="dish" aria-hidden="true">
        <Orbi size={64} />
        <i></i><i></i><i></i>
      </span>
      <span class="contact__addr">
        {site.email}
        <ArrowUpRightIcon className="contact__arrow" />
      </span>
    </a>

    <MessageForm />

    {site.socials.length > 0 && (
      <div class="contact__socials">
        <SocialList socials={site.socials} />
      </div>
    )}
  </section>
</BaseLayout>

<style>
  /* Icon là component React → cần :global để style scoped áp vào */
  .contact__mail :global(.contact__arrow) { width: 0.8em; height: 0.8em; transition: transform var(--dur) var(--ease-spring); }
  .contact__mail:hover :global(.contact__arrow) { transform: translate(3px, -3px); }
  /* Căn giữa như các trang khác (trừ Về tôi) */
  .contact {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-top: calc(var(--header-h) + var(--space-16));
  }
  h1 { font-size: var(--fs-h2); margin-block: var(--space-3) var(--space-6); max-width: 24ch; text-wrap: balance; }
  h1 em { color: var(--fg-muted); font-weight: 400; }
  .contact__intro { max-width: 68ch; font-size: var(--fs-lg); color: var(--fg-muted); text-wrap: balance; }

  /*
   * Email luôn một dòng: cỡ chữ không vượt quá bề ngang khung chia cho độ dài email
   * (Archivo ≈ 0,5em mỗi ký tự, cộng ~1,3em cho mũi tên). --mail-chars = số ký tự, đổi email trong CMS vẫn vừa.
   */
  .contact__mail {
    display: inline-flex;
    align-items: center;
    gap: var(--space-4);
    max-width: 100%;
    margin-top: var(--space-12);
    font-family: var(--font-display);
    font-size: min(clamp(1.5rem, 1rem + 3vw, 3.5rem), (100vw - 2 * var(--gutter)) / (var(--mail-chars, 22) * 0.5 + 1.3));
    text-decoration: none;
  }
  .contact__addr { display: inline-flex; align-items: center; gap: 0.15em; white-space: nowrap; }
  /* Điện thoại: Orbi lên trên, nhường cả bề ngang cho email */
  @media (max-width: 640px) {
    .contact__mail { flex-direction: column; gap: var(--space-3); }
  }
  .contact__mail:hover { color: var(--primary); }
  .dish { position: relative; flex: none; }
  /* Sóng tín hiệu lan ra khi rê chuột */
  .dish i {
    position: absolute;
    inset: 0;
    border: 2px solid var(--primary);
    border-radius: 50%;
    opacity: 0;
  }
  .contact__mail:hover .dish i { animation: wave 1.6s var(--ease-out) infinite; }
  .contact__mail:hover .dish i:nth-child(3) { animation-delay: 0.4s; }
  .contact__mail:hover .dish i:nth-child(4) { animation-delay: 0.8s; }
  @keyframes wave {
    from { opacity: 0.8; transform: scale(0.9); }
    to { opacity: 0; transform: scale(2.2); }
  }

  .contact__socials { width: min(100%, 720px); margin-top: var(--space-16); text-align: start; }
</style>
