---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ComingSoon from '@/components/sections/ComingSoon.astro';
import PageHeader from '@/components/sections/PageHeader.astro';
import JourneyGrid from '@/components/sections/JourneyGrid.astro';
import FlagStrip from '@/components/sections/FlagStrip.astro';
import { MissionsGlobe } from '@/components/media/MissionsGlobe';
import { getJourneys, hasStory, toGlobe } from '@/lib/content';
import { uniqueCountries } from '@/lib/flags';
import { getI18n, localeParams, fmt } from '@/lib/i18n';

export function getStaticPaths() {
  return localeParams();
}

const { t, locale } = getI18n(Astro.url);
const journeys = await getJourneys(locale);
const stories = journeys.filter(hasStory);
const { title, intro, code } = t.journeys;
const { points, flags } = toGlobe(journeys, locale);
const countries = uniqueCountries(journeys.map((j) => j.data));
---

<BaseLayout title={title} description={intro}>
  {journeys.length === 0 ? (
    <ComingSoon code={code} title={title} intro={intro} />
  ) : (
    <>
      <PageHeader code={code} title={title} intro={intro}>
        <p class="mono stats">{fmt(t.journeys.stats, { n: journeys.length, c: countries.length })}</p>
        <FlagStrip countries={countries} class="journeys-flags" />
      </PageHeader>
      <section class="container globe-wrap">
        <MissionsGlobe client:visible points={points} flags={flags} labels={{ label: fmt(t.journeys.globeLabel, { n: points.length }), hint: t.journeys.globeHint, zoomIn: t.journeys.zoomIn, zoomOut: t.journeys.zoomOut, zoomReset: t.journeys.zoomReset }} />
      </section>
      {stories.length > 0 && <JourneyGrid stories={stories} />}
    </>
  )}
</BaseLayout>

<style>
  .stats { margin-top: var(--space-6); color: var(--primary); }
  :global(.journeys-flags) { margin-top: var(--space-6); }
  .globe-wrap { margin-bottom: var(--section-y); }
</style>
