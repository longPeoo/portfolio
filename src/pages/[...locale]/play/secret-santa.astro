---
/**
 * /play/secret-santa: trò Secret Santa.
 * - Phần tĩnh (đầu trang, Cách chơi, nút về Sân chơi) render lúc build, không tốn JS.
 * - Phần chơi là island React SantaApp (client:load vì cả trang là ứng dụng; ngân sách 30 KB chỉ áp cho trang chủ).
 * - Phòng nằm trong ?code=… nên một file tĩnh phục vụ mọi phòng; máy chủ chỉ chạy ở /api/play/santa/*.
 */
import { ArrowLeftIcon, LinkIcon, PartyPopperIcon, UsersIcon } from 'lucide-react';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Orbi from '@/components/brand/Orbi.astro';
import PageHeader from '@/components/sections/PageHeader.astro';
import SectionHead from '@/components/sections/SectionHead.astro';
import SantaApp from '@/components/play/santa/SantaApp';
import { buttonVariants } from '@/components/ui/button';
import { Card, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';
import { cn } from '@/lib/utils';
import { getI18n, localeParams } from '@/lib/i18n';

export function getStaticPaths() {
  return localeParams();
}

const { t, intl, path } = getI18n(Astro.url);
const S = t.santa;
const steps = [
  { icon: UsersIcon, title: S.how1Title, text: S.how1Text },
  { icon: LinkIcon, title: S.how2Title, text: S.how2Text },
  { icon: PartyPopperIcon, title: S.how3Title, text: S.how3Text },
];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: S.title,
  description: S.metaDescription,
  applicationCategory: 'GameApplication',
  operatingSystem: 'Any',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: 0, priceCurrency: 'USD' },
};
---

<BaseLayout title={S.title} description={S.metaDescription} schema={schema}>
  <PageHeader code={S.code} title={S.title} intro={S.intro} />

  <section class="container santa" aria-label={S.title}>
    <SantaApp client:load labels={S} intl={intl}>
      <Orbi slot="orbi" size={96} />
    </SantaApp>
    <noscript><p class="santa__noscript">{S.noscript}</p></noscript>
  </section>

  <section class="container how" aria-label={S.howTitle}>
    <SectionHead code={S.howCode} title={S.howTitle} />
    <ol class="how__steps">
      {steps.map(({ icon: Icon, title, text }, i) => (
        <li>
          <Card className="h-full">
            <CardHeader>
              <p class="mono muted how__code">STEP {i + 1}<Icon aria-hidden="true" className="how__icon" /></p>
              <CardTitle className="font-heading text-xl font-bold">{title}</CardTitle>
              <CardDescription className="text-base">{text}</CardDescription>
            </CardHeader>
          </Card>
        </li>
      ))}
    </ol>
  </section>

  <div class="container back">
    <a href={path('/play')} class={cn(buttonVariants({ variant: 'launch-outline', size: 'pill' }), 'back__link')}>
      <ArrowLeftIcon data-icon="inline-start" />
      {t.play.back}
    </a>
  </div>
</BaseLayout>

<style>
  .santa { max-width: 960px; }
  .santa__noscript { text-align: center; color: var(--fg-muted); }
  .how { margin-top: var(--section-y); }
  .how :global(.shead) { margin-bottom: var(--space-8); }
  .how__steps { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: var(--space-6); margin: 0; padding: 0; list-style: none; }
  .how__code { display: flex; align-items: center; justify-content: space-between; }
  .how :global(.how__icon) { width: 20px; height: 20px; color: var(--primary); }
  .back { display: flex; justify-content: center; padding-block: var(--section-y); }
  .back :global(.back__link:hover [data-icon='inline-start']) { transform: translateX(-3px); }
</style>
