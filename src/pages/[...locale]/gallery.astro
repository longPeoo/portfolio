---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ComingSoon from '@/components/sections/ComingSoon.astro';
import PageHeader from '@/components/sections/PageHeader.astro';
import { PhotoGallery } from '@/components/media/PhotoGallery';
import { getPhotos } from '@/lib/content';
import { toGalleryPhotos } from '@/lib/photos';
import { getI18n, localeParams, fmt } from '@/lib/i18n';

export function getStaticPaths() {
  return localeParams();
}

const { t, locale, path } = getI18n(Astro.url);
const items = await getPhotos(locale);
const photos = await toGalleryPhotos(
  items.map((p) => ({ src: p.src, alt: p.alt, caption: p.caption, href: path(`/journeys/${p.journey.id}`) })),
);
const { title, intro, code } = t.gallery;
---

<BaseLayout title={title} description={intro}>
  {photos.length === 0 ? (
    <ComingSoon code={code} title={title} intro={intro} />
  ) : (
    <>
      <PageHeader code={code} title={title} intro={intro}>
        <p class="mono count">{fmt(t.gallery.count, { n: photos.length })}</p>
      </PageHeader>
      <section class="container">
        <PhotoGallery client:visible photos={photos} variant="polaroid" labels={t.gallery} />
      </section>
    </>
  )}
</BaseLayout>

<style>
  .count { margin-top: var(--space-6); color: var(--primary); }
</style>
