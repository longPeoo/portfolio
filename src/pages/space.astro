---
import { DownloadIcon } from 'lucide-react';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ComingSoon from '@/components/sections/ComingSoon.astro';
import PageHeader from '@/components/sections/PageHeader.astro';
import ProjectCard from '@/components/sections/ProjectCard.astro';
import { buttonVariants } from '@/components/ui/button';
import { getProjects } from '@/lib/content';
import { site } from '@/lib/site';
import { cn } from '@/lib/utils';
import { t } from '@/lib/i18n';

const projects = await getProjects();
const { title, intro, code } = t.space;
---

<BaseLayout title={title} description={intro}>
  {projects.length === 0 ? (
    <ComingSoon code={code} title={title} intro={intro}>
      {site.cv && (
        <a href={site.cv} class={cn(buttonVariants({ variant: 'launch', size: 'pill' }))} download>
          {t.space.cv} <DownloadIcon data-icon="inline-end" />
        </a>
      )}
    </ComingSoon>
  ) : (
    <>
      <PageHeader code={code} title={title} intro={intro}>
        {site.cv && (
          <a href={site.cv} class={cn(buttonVariants({ variant: 'launch', size: 'pill' }), 'cv')} download>
            {t.space.cv} <DownloadIcon data-icon="inline-end" />
          </a>
        )}
      </PageHeader>
      <section class="container grid">
        {projects.map((p, i) => <ProjectCard project={p} index={i} />)}
      </section>
    </>
  )}
</BaseLayout>

<style>
  .cv { margin-top: var(--space-8); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 420px), 1fr)); gap: var(--space-8); }
</style>
