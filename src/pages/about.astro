---
import { render } from 'astro:content';
import { DownloadIcon } from 'lucide-react';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ComingSoon from '@/components/sections/ComingSoon.astro';
import PageHeader from '@/components/sections/PageHeader.astro';
import CosmosBackdrop from '@/components/sections/CosmosBackdrop.astro';
import { buttonVariants } from '@/components/ui/button';
import { cn } from '@/lib/utils';
import { getPage } from '@/lib/content';
import { t } from '@/lib/i18n';

const page = await getPage('about');
const fallbackIntro = t.about.intro;
const Content = page ? (await render(page)).Content : undefined;
---

<BaseLayout title={page?.data.title ?? t.about.title} description={page?.data.intro ?? fallbackIntro}>
  {!page || !Content ? (
    <ComingSoon code={t.about.code} title={t.about.title} intro={fallbackIntro} />
  ) : (
    <>
      <PageHeader code={t.about.code} title={page.data.title} intro={page.data.intro}>
        {page.data.cv && (
          <a href={page.data.cv} class={cn(buttonVariants({ variant: 'launch', size: 'pill' }), 'about__cv')} download>
            {t.about.cv} <DownloadIcon data-icon="inline-end" />
          </a>
        )}
      </PageHeader>

      <!-- Nền vũ trụ: cuộn hết câu chuyện + timeline (data-cosmos-track) = camera lùi từ Hà Nội ra Dải Ngân Hà -->
      <CosmosBackdrop />
      <div class="container">
        <div data-cosmos-track>
          <section class="about__story prose prose-lg">
            <Content />
          </section>

          {page.data.timeline.length > 0 && (
            <section class="about__section" aria-labelledby="trajectory-title">
              <p class="mono muted">{t.about.trajectoryCode}</p>
              <h2 id="trajectory-title">{t.about.trajectoryTitle}</h2>
              <!-- Đường quỹ đạo tự vẽ khi cuộn; mỗi mốc là một lần "tách tầng" -->
              <div class="trajectory" data-trajectory>
                <span class="trajectory__line" aria-hidden="true"><span data-trajectory-line></span></span>
                <ol>
                  {page.data.timeline.map((m, i) => (
                    <li class="stage" data-stage data-year={m.year} data-title={m.title}>
                      <span class="stage__dot" aria-hidden="true"></span>
                      <p class="mono stage__year">T+{String(i).padStart(2, '0')} · {m.year}</p>
                      <h3>{m.title}</h3>
                      <p class="muted">{m.text}</p>
                    </li>
                  ))}
                </ol>
              </div>
            </section>
          )}
        </div>
      </div>

      {page.data.subsystems.length > 0 && (
        <section class="container about__section" aria-labelledby="subsystems-title">
          <p class="mono muted">{t.about.skillsCode}</p>
          <h2 id="subsystems-title">{t.about.skillsTitle}</h2>
          <div class="subsystems">
            {page.data.subsystems.map((s) => (
              <div class="subsystem" data-reveal>
                <div class="subsystem__head">
                  <span class="mono subsystem__code">{s.code}</span>
                  <span class="mono subsystem__status"><i aria-hidden="true"></i>{t.common.status.nominal}</span>
                </div>
                <h3>{s.name}</h3>
                <div class="subsystem__meter">
                  <div class="gauge" role="meter" aria-valuemin={0} aria-valuemax={100} aria-valuenow={s.level} aria-label={`${s.name}: ${s.level}%`}>
                    <span data-gauge style={`--level:${s.level}%`}></span>
                  </div>
                  <span class="mono muted gauge__value" aria-hidden="true">{s.level}%</span>
                </div>
                <ul>{s.items.map((it) => <li>{it}</li>)}</ul>
              </div>
            ))}
          </div>
        </section>
      )}
    </>
  )}
</BaseLayout>

<style>
  .about__cv { margin-top: var(--space-8); }
  /* Câu chuyện mở đầu: khối giữa trang, căn giữa */
  .about__story { max-width: 60ch; margin-inline: auto; margin-top: var(--space-12); text-align: center; text-wrap: pretty; }
  .about__section { margin-top: var(--section-y); }
  .about__section h2 { font-size: var(--fs-h2); margin-block: var(--space-3) var(--space-12); }

  .trajectory { position: relative; max-width: 720px; padding-left: var(--space-12); }
  .trajectory ol { list-style: none; padding: 0; display: grid; gap: var(--space-12); }
  .trajectory__line {
    position: absolute;
    left: 11px;
    top: 8px;
    bottom: 8px;
    width: 2px;
    background: repeating-linear-gradient(var(--line) 0 6px, transparent 6px 12px);
  }
  .trajectory__line span { position: absolute; inset: 0; background: var(--primary); transform-origin: top; transform: scaleY(var(--progress, 1)); }
  .stage { position: relative; }
  .stage__dot {
    position: absolute;
    left: calc(var(--space-12) * -1 + 4px);
    top: 4px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--bg);
    border: 3px solid var(--primary);
    box-shadow: 0 0 0 5px var(--bg);
  }
  .stage__year { color: var(--primary); }
  .stage h3 { font-size: var(--fs-h3); margin-block: var(--space-2); }

  .subsystems { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr)); gap: var(--space-4); }
  /* Subgrid: các thẻ cùng hàng dùng chung 4 dòng (nhãn, tên, thanh đo, danh sách)
     → tên dài xuống dòng thì cả hàng cùng giãn, thanh đo và danh sách luôn thẳng hàng */
  .subsystem {
    display: grid;
    grid-row: span 4;
    grid-template-rows: subgrid;
    row-gap: var(--space-3);
    padding: var(--space-4) var(--space-6) var(--space-6);
    border: 1px solid var(--line);
    border-radius: var(--r);
    background: var(--bg-elev);
  }
  .subsystem__head { display: flex; justify-content: space-between; align-items: center; }
  .subsystem__code { color: var(--primary); }
  .subsystem__status { display: inline-flex; align-items: center; gap: 6px; color: var(--ok); font-size: 0.625rem; }
  .subsystem__status i { width: 7px; height: 7px; border-radius: 50%; background: currentColor; animation: led 2.4s ease-in-out infinite; }
  .subsystem h3 { align-self: start; font-size: 1.125rem; line-height: 1.2; text-wrap: balance; }
  .subsystem__meter { display: flex; align-items: center; gap: var(--space-3); }
  .subsystem__meter .gauge { flex: 1; }
  .gauge { height: 8px; border-radius: var(--r-pill); background: var(--bg-sunken); overflow: hidden; }
  .gauge span {
    display: block;
    height: 100%;
    width: var(--level);
    border-radius: inherit;
    background: linear-gradient(90deg, var(--c-sun), var(--primary));
    transform-origin: left;
  }
  .gauge__value { font-size: 0.6875rem; min-width: 4ch; text-align: right; }
  .subsystem ul { margin: 0; padding-left: 1.1em; font-size: var(--fs-sm); line-height: 1.55; color: var(--fg-muted); }
  .subsystem li::marker { color: var(--primary); }
  @keyframes led { 50% { opacity: 0.35; } }
</style>
